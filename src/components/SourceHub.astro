---
/**
 * Four sources wired into one library at the centre.
 *
 * Node coordinates are given in the SVG's own viewBox units and reused as
 * percentages for the HTML pills, so the wires stay anchored to the pills at
 * every size. The container carries a matching aspect-ratio, which means the
 * SVG scales uniformly and nothing skews. Everything else is sized in `cqw`
 * against the container, which lets the figure shrink as a whole rather than
 * needing a breakpoint per column width.
 */
const VB = { w: 160, h: 100 };
const HUB = { x: 80, y: 50 };

const nodes = [
  { label: 'Your Plex', x: 34, y: 22 },
  { label: 'Your Jellyfin', x: 126, y: 22 },
  { label: 'A friend’s Emby', x: 34, y: 78 },
  { label: 'The NAS in the closet', x: 126, y: 78 },
];

const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(3)}%`;
---

<figure class="hub">
  <svg
    class="hub-wires"
    viewBox={`0 0 ${VB.w} ${VB.h}`}
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
  >
    {
      nodes.map((n) => (
        <line
          class="hub-wire"
          x1={n.x}
          y1={n.y}
          x2={HUB.x}
          y2={HUB.y}
          vector-effect="non-scaling-stroke"
        />
      ))
    }
    {
      nodes.map((n, i) => (
        <line
          class="hub-pulse"
          x1={n.x}
          y1={n.y}
          x2={HUB.x}
          y2={HUB.y}
          pathLength="100"
          style={`--delay: ${(i * 1.05).toFixed(2)}s`}
          vector-effect="non-scaling-stroke"
        />
      ))
    }
  </svg>

  <ul class="hub-nodes">
    {
      nodes.map((n) => (
        <li
          class="hub-node"
          style={`--x: ${pct(n.x, VB.w)}; --y: ${pct(n.y, VB.h)}`}
        >
          {n.label}
        </li>
      ))
    }
  </ul>

  <div class="hub-core">
    <span class="hub-core-mark">
      <img src="/logo.svg" alt="" width="40" height="40" />
    </span>
    <figcaption class="hub-core-label">One library</figcaption>
  </div>
</figure>
