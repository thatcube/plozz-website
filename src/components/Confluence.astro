---
/**
 * Four sources, one library.
 *
 * Four hairlines leave the source lockups and converge on a single point where
 * the Plozz mark sits. Sources are shown as their real wordmarks so they read
 * as the products people already know; network shares have no logo, so that
 * node is an icon plus the word.
 *
 * Both layouts are generated from one set of percentages, so the SVG endpoints
 * and the CSS-positioned lockups cannot drift apart. A wide arrangement suits
 * the two-column slab; below ~430px of illustration width the wordmarks would
 * be too small to read, so a taller arrangement gives the lockup column roughly
 * half the width and shortens the wire run instead.
 */
import { Icon } from "astro-icon/components";

const SOURCES = [
  { name: "Plex", src: "/providers/plex.svg" },
  { name: "Jellyfin", src: "/providers/jellyfin.svg" },
  { name: "Emby", src: "/providers/emby.png" },
  { name: "Shares", icon: "ph:folders" },
];

/* Vertical position of each source, as a percentage of the stage height. Shared
   by both layouts and by the CSS, so rows and wire ends always agree. */
const ROW_PCT = [11.9, 37.3, 62.7, 88.1];

/* Half the hub tile's width (17.5% of the stage) in viewBox units. Wires stop
   just short of its flat left edge. */
const HUB_R = 42;

type Layout = {
  /* viewBox height; width is always 480 so one unit means the same in both. */
  h: number;
  /* Where the lockup column ends, as a percentage of stage width. */
  lockRight: number;
  /* Hub centre, as a percentage of stage width. */
  hubX: number;
};

const WIDE: Layout = { h: 380, lockRight: 31.25, hubX: 88.33 };
const NARROW: Layout = { h: 520, lockRight: 48.3, hubX: 85 };

const VB_W = 480;

function wires(L: Layout) {
  const hubY = L.h / 2;
  const startX = (L.lockRight / 100) * VB_W + 16;
  const endX = (L.hubX / 100) * VB_W - HUB_R - 2;
  const run = endX - startX;

  return ROW_PCT.map((p) => {
    const y = (p / 100) * L.h;
    /* Lines leave and arrive flat and do their bending in the middle. The
       outgoing handle grows with vertical distance, so the outer lines hold
       their line longer and the four arrive as a fan rather than a braid.
       Scaling it by the run keeps that shape when the run gets short. */
    const vFrac = Math.abs(y - hubY) / hubY;
    const cp1 = startX + run * (0.45 + 0.35 * vFrac);
    const cp2 = endX - run * 0.5;
    const r = (n: number) => Math.round(n * 10) / 10;
    return `M${r(startX)} ${r(y)} C${r(cp1)} ${r(y)} ${r(cp2)} ${hubY} ${r(endX)} ${hubY}`;
  });
}

const LAYOUTS = [
  { cls: "wires-wide", L: WIDE },
  { cls: "wires-narrow", L: NARROW },
];
---

<div class="confluence">
  <div class="confluence-stage">
    {
      LAYOUTS.map(({ cls, L }) => (
        <svg
          class:list={["confluence-wires", cls]}
          viewBox={`0 0 ${VB_W} ${L.h}`}
          fill="none"
          aria-hidden="true"
          preserveAspectRatio="xMidYMid meet"
        >
          {wires(L).map((d, i) => (
            <g>
              <path class="wire" d={d} />
              <path class="wire-pulse" d={d} style={`--i:${i}`} />
            </g>
          ))}
        </svg>
      ))
    }

    <ul class="confluence-sources">
      {
        SOURCES.map((s, i) => (
          <li class="source-node" style={`--row:${ROW_PCT[i]}%`}>
            {s.icon ? (
              <span class="source-shares">
                <Icon name={s.icon} />
                <span>{s.name}</span>
              </span>
            ) : (
              <img src={s.src} alt="" />
            )}
          </li>
        ))
      }
    </ul>

    <div class="confluence-hub">
      <img src="/plozz-app-icon.webp" alt="" width="384" height="384" />
    </div>
  </div>

  <span class="sr-only">
    Plozz brings Plex, Jellyfin, Emby and network shares into one library.
  </span>
</div>
