---
/**
 * What happens to a file between the server and the television: nothing.
 *
 * The claim these pages rest on is "direct play", which is jargon, and the
 * pages used to spend a paragraph explaining it. It is a picture: a file's
 * tracks leave the server, cross the gap without passing through anything,
 * and arrive whole. Drawing it says in one look what the paragraph said in
 * four lines, and it survives someone who only scans.
 *
 * The tracks fan apart in the middle on purpose. A transcode is a funnel —
 * separate streams go in and one re-encoded stream comes out — so showing
 * them stay separate the whole way across is the actual difference, not a
 * decoration. Every label is a real codec, because the demo is the only place
 * real option names belong.
 *
 * Geometry lives here rather than in the stylesheet so the wire ends and the
 * HTML labels are generated from the same numbers and cannot drift apart.
 */
import { Icon } from "astro-icon/components";

export interface Props {
  /** Provider wordmark shown at the left. */
  logo?: string;
  /** Used instead of a wordmark when the source has no logo of its own. */
  icon?: string;
  /** Accessible name for the source, and the label under a bare icon. */
  source: string;
}

const { logo, icon, source } = Astro.props;

const VB_W = 480;
const VB_H = 206;

/* Where the wires leave and land, in viewBox units. Both nodes are lockups of
   unknown width, so the wires stop at a fixed inset and the nodes are anchored
   by the edge the wires touch. */
const START_X = 116;
const END_X = 364;
const CENTRE_Y = VB_H / 2;

/* The flat middle, where the labels sit. */
const MID_L = 168;
const MID_R = 312;

const TRACKS = [
  { icon: "ph:film-strip", label: "HEVC · Dolby Vision", y: 51 },
  { icon: "ph:waveform", label: "TrueHD · Atmos", y: 103 },
  { icon: "ph:subtitles", label: "PGS · SRT", y: 155 },
];

/* Leaves and arrives flat, bends only on the way out and the way in. The
   handles scale with vertical distance so the outer two hold their line rather
   than sagging toward the middle one. */
function wire(y: number) {
  const r = (n: number) => Math.round(n * 10) / 10;
  const lead = (MID_L - START_X) * 0.55;
  return [
    `M${START_X} ${CENTRE_Y}`,
    `C${r(START_X + lead)} ${CENTRE_Y} ${r(MID_L - lead)} ${y} ${MID_L} ${y}`,
    `L${MID_R} ${y}`,
    `C${r(MID_R + lead)} ${y} ${r(END_X - lead)} ${CENTRE_Y} ${END_X} ${CENTRE_Y}`,
  ].join(" ");
}

/* Staggered so the three arrivals read as a rhythm rather than a single thick
   pulse crossing three times. */
const DELAY_S = [0, 0.42, 0.84];

const pct = (n: number, of: number) => `${Math.round((n / of) * 1000) / 10}%`;
---

<div class="dpath">
  <div class="dpath-stage">
    <svg
      class="dpath-wires"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      fill="none"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
    >
      {TRACKS.map((t) => <path class="dpath-wire" d={wire(t.y)} />)}
      {
        TRACKS.map((t, i) => (
          <path
            class="dpath-pulse"
            d={wire(t.y)}
            pathLength="100"
            style={`--d:${DELAY_S[i]}s`}
          />
        ))
      }
    </svg>

    <div class="dpath-node dpath-source">
      {
        logo ? (
          <img src={logo} alt={source} width="120" height="32" />
        ) : (
          <span class="dpath-bare">
            {icon && <Icon name={icon} />}
            {source}
          </span>
        )
      }
    </div>

    {/* The Apple TV app mark. It is a knockout — the tile is filled and the
        lockup is punched through it — so it takes its colour from the node
        and needs no second copy for light and dark.

        No words beside it: the mark already sets them. */}
    <div class="dpath-node dpath-dest">
      <svg viewBox="0 0 11.83 11.79" role="img" aria-label="Apple TV">
        <path
          fill="currentColor"
          d="M3.2168 11.7832C2.15039 11.7832 1.31836 11.666 0.708984 11.0625C0.111328 10.4648 0 9.63867 0 8.56641V3.19922C0 2.15039 0.111328 1.32422 0.714844 0.720703C1.3125 0.117188 2.15039 0 3.19922 0H8.60742C9.67383 0 10.5059 0.117188 11.1094 0.714844C11.7129 1.31836 11.8242 2.14453 11.8242 3.2168V8.56641C11.8242 9.63867 11.7129 10.459 11.1094 11.0625C10.5117 11.666 9.67383 11.7832 8.60742 11.7832H3.2168ZM3.25195 4.58789C3.72656 4.64062 4.10742 4.11914 4.06641 3.68555C3.5918 3.71484 3.23438 4.14258 3.25195 4.58789ZM6.50391 3.98438H5.89453V4.68164H5.4668V5.15625H5.89453V6.87891C5.89453 7.4707 6.12891 7.6875 6.73242 7.6875C6.86719 7.6875 7.01367 7.66992 7.06641 7.66406V7.16602C7.03711 7.17773 6.92578 7.17773 6.86719 7.17773C6.62109 7.17773 6.50391 7.07812 6.50391 6.80859V5.15625H7.07812V4.68164H6.50391V3.98438ZM4.88672 6.64453C4.65234 6.53906 4.51172 6.39258 4.42383 6.18164C4.33594 5.94141 4.35352 5.70703 4.42383 5.50781C4.47656 5.37305 4.55859 5.20312 4.78711 5.07422C4.61719 4.81641 4.34766 4.68164 4.02539 4.68164C3.66211 4.68164 3.45117 4.875 3.26953 4.875C3.11719 4.875 2.94727 4.69336 2.6543 4.69336C2.34375 4.69336 2.08594 4.81641 1.91602 5.03906C1.7168 5.2793 1.63477 5.58398 1.63477 5.90039C1.63477 6.41602 1.86328 7.01953 2.20312 7.40039C2.37891 7.59961 2.51953 7.69922 2.67773 7.69922C2.92383 7.69922 3.05273 7.52344 3.3457 7.52344C3.47461 7.52344 3.58008 7.57617 3.65625 7.59961C3.77344 7.63477 3.85547 7.6875 3.99609 7.6875C4.14258 7.6875 4.25391 7.62891 4.33594 7.55859C4.59961 7.30664 4.79883 6.94336 4.88672 6.64453ZM9.09375 7.66406L10.166 4.68164H9.50391L8.77148 7.07812L8.00391 4.68164H7.35352L8.44922 7.66406H9.09375Z"
        ></path>
      </svg>
    </div>

    {
      TRACKS.map((t) => (
        <span class="dpath-track" style={`--y:${pct(t.y, VB_H)}`}>
          <Icon name={t.icon} />
          {t.label}
        </span>
      ))
    }
  </div>
</div>
