---
/**
 * A line, with your things on one side of it and almost nothing on ours.
 *
 * This replaces a drawing of wires running to two destinations, one of them
 * struck through. That version had to be decoded — two curves, a dashed one,
 * a crossed-out word — and the reader had to assemble the claim themselves.
 *
 * A boundary needs no decoding. Everything Plozz holds sits on the viewer's
 * side of a line; our side holds one item, switched off. The imbalance is the
 * argument, and it is legible before a single label is read.
 *
 * The one item on the right is the honest part. A privacy picture with a
 * genuinely empty half would be a lie: crash reports exist, they are real,
 * and they can reach us if someone lets them.
 */
import { Icon } from "astro-icon/components";

const YOURS = [
  { icon: "ph:sliders-horizontal", label: "Settings" },
  { icon: "ph:play-circle", label: "Watch progress" },
  { icon: "ph:users-three", label: "Profiles" },
  { icon: "ph:hard-drives", label: "Server details" },
];
---

<section class="band" aria-labelledby="nothing-comes-to-us">
  <div class="container">
    <div class="band-head">
      <h2 id="nothing-comes-to-us">Nothing comes to us</h2>
    </div>

    <div class="ledger">
  <div class="ledger-side">
    <p class="ledger-head">Yours, and your iCloud</p>

    <ul class="ledger-items">
      {
        YOURS.map((y) => (
          <li>
            <Icon name={y.icon} />
            {y.label}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="ledger-side is-ours">
    <p class="ledger-head">Ours</p>

    <ul class="ledger-items">
      <li class="is-off">
        <Icon name="ph:bug" />
        Crash reports
        <span class="ledger-off">off</span>
      </li>
    </ul>
      </div>
    </div>

    <p class="ledger-note">
      There are no analytics in Plozz, and no Plozz account to make. Your
      settings and progress sync through your own iCloud, which we can’t read.
      Crash reports are the one thing that could reach us, and they stay off
      until you switch them on.
    </p>
  </div>
</section>
