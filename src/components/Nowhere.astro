---
/**
 * Where your data goes, which is to your iCloud and not to us.
 *
 * The first version of this drew three wires fading into nothing, captioned
 * "nothing at the other end". That read well and wasn't quite true: settings
 * and progress really do leave the device, into the viewer's own iCloud. A
 * privacy picture that overstates its case is worse than a paragraph.
 *
 * So there are two ends now. One is real and labelled, and it is theirs. The
 * other is us, and that wire is the one that fades out — drawn dashed and
 * fading rather than absent, because the honest claim isn't that nothing
 * leaves, it's that nothing comes here.
 */
import { Icon } from "astro-icon/components";
---

<div class="nowhere">
  <div class="nowhere-device">
    <Icon name="ph:television-simple" />
    <span>Your Apple TV</span>
  </div>

  <div class="nowhere-run">
    <svg
      class="nowhere-wires"
      viewBox="0 0 300 130"
      fill="none"
      aria-hidden="true"
      preserveAspectRatio="none"
    >
      <defs>
        <linearGradient id="nowhere-fade" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#4a4a52" stop-opacity="1"></stop>
          <stop offset="0.5" stop-color="#4a4a52" stop-opacity="0.4"></stop>
          <stop offset="1" stop-color="#4a4a52" stop-opacity="0"></stop>
        </linearGradient>
      </defs>

      {/* Up to iCloud: arrives, and stays lit the whole way. */}
      <path d="M0 65 C70 65 96 24 210 24" stroke="#4a4a52" stroke-width="1.25"
      ></path>

      {/* Toward us: leaves, thins out, and never lands. */}
      <path
        d="M0 65 C70 65 96 108 210 108"
        stroke="url(#nowhere-fade)"
        stroke-width="1.25"
        stroke-dasharray="3 5"></path>
    </svg>

    <span class="nowhere-to nowhere-real">
      <Icon name="ph:cloud" />
      Your iCloud
    </span>

    <span class="nowhere-to nowhere-absent">Us</span>
  </div>
</div>
