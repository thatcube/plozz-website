---
/**
 * Two rows of screenshots drifting in opposite directions. The track is
 * rendered twice so the loop is seamless; the duplicate is hidden from
 * assistive tech.
 *
 * Rows are ordered so no two shots of the same device sit next to each other,
 * including across the loop seam. The iPad and iPhone shots are spaced evenly
 * through the Apple TV ones so they read as punctuation rather than a clump.
 *
 * Tiles never paint wider than 540 CSS px, so these ladders top out at 1080 and
 * a phone pulls the 360px rung instead of a full-size screenshot.
 *
 * They also load at low priority. Native lazy loading is not enough on a slow
 * connection: the browser widens its lazy threshold when bandwidth is scarce,
 * so all sixteen tiles used to start downloading a second into the page and
 * split the pipe with the hero, dragging LCP out to 44s on Slow 3G.
 */
import Shot from './Shot.astro';
import { MARQUEE, MARQUEE_PORTRAIT } from '../data/imageSizes';

/** The tall iPhone tiles paint about a quarter as wide as the landscape ones. */
const PORTRAIT = new Set(['plozz-iphone', 'plozz-iphone-library']);
const sizesFor = (name: string) => (PORTRAIT.has(name) ? MARQUEE_PORTRAIT : MARQUEE);

const rowOne = [
  { name: 'plozz-tv-show', alt: 'A series detail screen on Apple TV' },
  { name: 'plozz-ipad-info', alt: 'Episode details during playback on iPad' },
  { name: 'plozz-tv-home', alt: 'Plozz home screen on Apple TV' },
  { name: 'plozz-tv-library', alt: 'Movie library on Apple TV' },
  { name: 'plozz-iphone-library', alt: 'A movie library on iPhone' },
  { name: 'plozz-tv-episodes', alt: 'Season and episode picker on Apple TV' },
  { name: 'plozz-ipad-player', alt: 'Playback controls on iPad' },
  { name: 'plozz-tv-settings', alt: 'Settings on Apple TV' },
];

const rowTwo = [
  { name: 'plozz-tv-ratings', alt: 'Cast and ratings on Apple TV' },
  { name: 'plozz-ipad', alt: 'Plozz on iPad' },
  { name: 'plozz-tv-subtitles', alt: 'Subtitle styling during playback' },
  { name: 'plozz-tv-profiles', alt: 'Profile picker on Apple TV' },
  { name: 'plozz-iphone', alt: 'Plozz on iPhone' },
  { name: 'plozz-tv', alt: 'A film detail screen on Apple TV' },
  { name: 'plozz-ipad-cast', alt: 'Cast list during playback on iPad' },
  { name: 'plozz-tv-profile-edit', alt: 'Editing a profile on Apple TV' },
];
---

<section class="marquee" aria-label="Plozz on Apple TV, iPhone and iPad" data-lazy-group>
  <div class="marquee-row">
    <div class="marquee-track">
      {[0, 1].map((pass) =>
        rowOne.map((shot) => (
          <Shot
            name={shot.name}
            alt={pass === 0 ? shot.alt : ''}
            sizes={sizesFor(shot.name)}
            fetchpriority="low"
            defer="viewport"
            ariaHidden={pass === 1}
          />
        ))
      )}
    </div>
  </div>

  <div class="marquee-row">
    <div class="marquee-track is-reverse">
      {[0, 1].map((pass) =>
        rowTwo.map((shot) => (
          <Shot
            name={shot.name}
            alt={pass === 0 ? shot.alt : ''}
            sizes={sizesFor(shot.name)}
            fetchpriority="low"
            defer="viewport"
            ariaHidden={pass === 1}
          />
        ))
      )}
    </div>
  </div>
</section>
