---
/**
 * Two rows of screenshots drifting in opposite directions. The track is
 * rendered twice so the loop is seamless; the duplicate is hidden from
 * assistive tech.
 */
const rowOne = [
  { src: '/screenshots/plozz-tv-show.webp', alt: 'A series detail screen on Apple TV', w: 2000, h: 1125 },
  { src: '/screenshots/plozz-tv-home.webp', alt: 'Plozz home screen on Apple TV', w: 2000, h: 1119 },
  { src: '/screenshots/plozz-tv-library.webp', alt: 'Movie library on Apple TV', w: 2000, h: 1125 },
  { src: '/screenshots/plozz-tv-episodes.webp', alt: 'Season and episode picker on Apple TV', w: 2000, h: 1125 },
  { src: '/screenshots/plozz-tv-settings.webp', alt: 'Settings on Apple TV', w: 2000, h: 1125 },
];

const rowTwo = [
  { src: '/screenshots/plozz-tv-ratings.webp', alt: 'Cast and ratings on Apple TV', w: 2000, h: 1125 },
  { src: '/screenshots/plozz-ipad.webp', alt: 'Plozz on iPad', w: 1084, h: 757 },
  { src: '/screenshots/plozz-tv-profiles.webp', alt: 'Profile picker on Apple TV', w: 2000, h: 1125 },
  { src: '/screenshots/plozz-tv.webp', alt: 'A film detail screen on Apple TV', w: 1088, h: 612 },
  { src: '/screenshots/plozz-tv-profile-edit.webp', alt: 'Editing a profile on Apple TV', w: 2000, h: 1125 },
  { src: '/screenshots/plozz-iphone.webp', alt: 'Plozz on iPhone', w: 738, h: 1603 },
];
---

<section class="marquee" aria-label="Plozz on Apple TV, iPhone and iPad">
  <div class="marquee-row">
    <div class="marquee-track">
      {[0, 1].map((pass) =>
        rowOne.map((shot) => (
          <img
            src={shot.src}
            alt={pass === 0 ? shot.alt : ''}
            width={shot.w}
            height={shot.h}
            loading="lazy"
            decoding="async"
            aria-hidden={pass === 1 ? 'true' : undefined}
          />
        ))
      )}
    </div>
  </div>

  <div class="marquee-row">
    <div class="marquee-track is-reverse">
      {[0, 1].map((pass) =>
        rowTwo.map((shot) => (
          <img
            src={shot.src}
            alt={pass === 0 ? shot.alt : ''}
            width={shot.w}
            height={shot.h}
            loading="lazy"
            decoding="async"
            aria-hidden={pass === 1 ? 'true' : undefined}
          />
        ))
      )}
    </div>
  </div>
</section>
