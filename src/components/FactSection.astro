---
export interface Fact {
  name: string;
  value?: string;
  chips?: string[];
}

export interface Props {
  title: string;
  lead?: string;
  facts: Fact[];
  cols?: number;
}

const { title, lead, facts, cols = 3 } = Astro.props;
const headingId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

{/* Heading outside the slab, on the page keyline. */}
<section class="band" aria-labelledby={headingId}>
  <div class="container">
    <div class="band-head">
      <h2 id={headingId}>{title}</h2>
      {lead && <p>{lead}</p>}
    </div>

    <ul class="slab" style={`--cols: ${cols}`}>
      {facts.map((fact) => (
        <li class="cell">
          <h3>{fact.name}</h3>
          {fact.value && <p>{fact.value}</p>}
          {fact.chips && (
            <span class="cell-chips">
              {fact.chips.map((chip) => <span class="chip">{chip}</span>)}
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
