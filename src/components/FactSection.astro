---
export interface Fact {
  name: string;
  detail: string;
}

export interface Props {
  title: string;
  lead?: string;
  facts: Fact[];
  panel?: boolean;
}

const { title, lead, facts, panel = false } = Astro.props;
const headingId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<section class:list={['fact-section', { 'is-panel': panel }]} aria-labelledby={headingId}>
  <div class="container">
    <div class="fact-intro">
      <h2 id={headingId}>{title}</h2>
      {lead && <p>{lead}</p>}
    </div>
    <dl class="fact-rows">
      {facts.map((fact) => (
        <div>
          <dt>{fact.name}</dt>
          <dd>{fact.detail}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
