---
/**
 * Subtitles are the thing Plozz is deepest on, so the page demonstrates them
 * instead of listing them. The presets and fonts here are the real ones.
 */
const presets = [
  { id: 'clean', label: 'Clean' },
  { id: 'boxed', label: 'Boxed' },
  { id: 'outline', label: 'Outline' },
  { id: 'yellow', label: 'Classic Yellow' },
];

const fonts = [
  { id: 'atkinson', label: 'Atkinson Hyperlegible', note: 'Built so similar letters stop looking alike' },
  { id: 'system', label: 'System', note: 'San Francisco, the Apple default' },
  { id: 'dyslexic', label: 'OpenDyslexic', note: 'Weighted bottoms to stop letters flipping' },
];
---

<div class="sublab" data-sublab>
  <div class="sublab-stage">
    <div class="sublab-frame">
      <span class="sublab-caption" data-sublab-caption>
        You can read this from the sofa.
      </span>
    </div>
    <p class="sublab-note" data-sublab-note>{fonts[0].note}</p>
  </div>

  <div class="sublab-controls">
    <fieldset>
      <legend>Preset</legend>
      <div class="sublab-options">
        {presets.map((preset, index) => (
          <label class="sublab-option">
            <input
              type="radio"
              name="sublab-preset"
              value={preset.id}
              checked={index === 0}
              data-sublab-preset
            />
            <span>{preset.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend>Typeface</legend>
      <div class="sublab-options">
        {fonts.map((font, index) => (
          <label class="sublab-option">
            <input
              type="radio"
              name="sublab-font"
              value={font.id}
              checked={index === 0}
              data-sublab-font
              data-note={font.note}
            />
            <span>{font.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>
</div>

<script>
  document.querySelectorAll('[data-sublab]').forEach((lab) => {
    const caption = lab.querySelector('[data-sublab-caption]');
    const note = lab.querySelector('[data-sublab-note]');

    const apply = () => {
      const preset = lab.querySelector('[data-sublab-preset]:checked');
      const font = lab.querySelector('[data-sublab-font]:checked');
      caption.dataset.preset = preset ? preset.value : 'clean';
      caption.dataset.font = font ? font.value : 'atkinson';
      if (font && note) note.textContent = font.dataset.note;
    };

    lab.addEventListener('change', apply);
    apply();
  });
</script>
