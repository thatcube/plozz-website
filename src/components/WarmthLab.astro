---
/**
 * Circadian mode is hard to describe and easy to show: warm the panel and the
 * point makes itself. Levels and names are the app's own.
 */
const levels = ['None', 'Kinda Warm', 'Warm', 'Toasty', 'Roasting', 'On Fire'];
---

<div class="warmlab" data-warmlab>
  <div class="warmlab-stage">
    <img
      src="/screenshots/plozz-tv-home.webp"
      alt="Plozz home screen, shown with the circadian warmth overlay applied"
      width="2000"
      height="1119"
      loading="lazy"
      decoding="async"
    />
    <span class="warmlab-tint" data-warmlab-tint></span>
  </div>

  <fieldset class="warmlab-controls">
    <legend>Warmth</legend>
    <div class="warmlab-options">
      {levels.map((level, index) => (
        <label class="sublab-option">
          <input
            type="radio"
            name="warmlab"
            value={index}
            checked={index === 0}
            data-warmlab-level
          />
          <span>{level}</span>
        </label>
      ))}
    </div>
  </fieldset>
</div>

<script>
  document.querySelectorAll('[data-warmlab]').forEach((lab) => {
    const tint = lab.querySelector('[data-warmlab-tint]');

    const apply = () => {
      const level = lab.querySelector('[data-warmlab-level]:checked');
      tint.dataset.level = level ? level.value : '0';
    };

    lab.addEventListener('change', apply);
    apply();
  });
</script>
