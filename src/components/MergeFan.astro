---
/**
 * Option 2 — a stepped stack collapsing into one.
 *
 * Each source card is offset far enough that its top edge stays exposed, so
 * every label is legible instead of buried under the card in front. The lit
 * card at the front is the result, and it is the only one carrying colour.
 *
 * The cards hold nothing but their own name, so there is no invented artwork
 * to read as a mockup.
 */
const sources = [
  'Your Plex',
  'Your Jellyfin',
  'A friend’s Emby',
  'The NAS in the closet',
];
const STEP = 10.5; // vertical share of the stage each card gives up
---

<figure class="fan">
  <div class="fan-stack">
    {
      sources.map((label, i) => (
        <div class="fan-card" style={`--i: ${i}; --step: ${STEP}%`}>
          <span class="fan-label">{label}</span>
        </div>
      ))
    }
    <div
      class="fan-card is-one"
      style={`--i: ${sources.length}; --step: ${STEP}%`}
    >
      <span class="fan-one">One library</span>
    </div>
  </div>
</figure>
