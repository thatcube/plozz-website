---
export interface Props {
  question: string;
  detail?: string;
  flip?: boolean;
}

const { question, detail, flip = false } = Astro.props;
const id = question.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<section class="band showcase" aria-labelledby={id}>
  <div class="container">
    <div class="band-head">
      <h2 id={id}>{question}</h2>
    </div>

    <div class:list={['slab showcase-slab', { 'is-flipped': flip }]}>
      <div class="cell showcase-demo">
        <slot />
      </div>
      {detail && (
        <div class="cell showcase-note">
          <p>{detail}</p>
        </div>
      )}
    </div>
  </div>
</section>
