---
/**
 * Four sources becoming one library.
 *
 * The four strands are dim and separate; where they meet, the merged strand
 * turns luminous and becomes the shelf everything lands on. That contrast is
 * the whole idea — the combination is the valuable thing, so it gets the
 * light.
 *
 * The curves are SVG and the shelf is HTML, which sounds odd but is the point:
 * the spines then reflow on their own when the figure stacks on a phone,
 * instead of needing a second drawing. The two meet because both are placed
 * from the same viewBox coordinates — the container's aspect-ratio matches the
 * viewBox, so a percentage means the same thing in either technology.
 */
const VB = { w: 160, h: 100 };
const FROM_X = 50; // where a strand leaves its label
const JOIN = { x: 92, y: 50 }; // where four become one
const SHELF = { from: 99, to: 148 }; // the run the spines stand on

const sources = [
  { label: 'Your Plex', y: 12 },
  { label: 'Your Jellyfin', y: 37.333 },
  { label: 'A friend’s Emby', y: 62.667 },
  { label: 'The NAS in the closet', y: 88 },
];

/**
 * Spines. Widths vary a lot, heights barely — that ratio is what makes a row
 * of rectangles read as a packed shelf rather than a bar chart.
 */
const spines = [
  { w: 3.2, h: 30 },
  { w: 2.4, h: 27 },
  { w: 3.8, h: 31 },
  { w: 2.0, h: 28 },
  { w: 3.0, h: 32 },
  { w: 2.6, h: 26 },
  { w: 3.4, h: 30.5 },
  { w: 2.2, h: 25.5 },
  { w: 3.6, h: 31 },
  { w: 2.8, h: 28 },
  { w: 2.0, h: 26 },
  { w: 3.2, h: 30 },
  { w: 2.4, h: 32 },
  { w: 3.0, h: 28 },
];

const GAP = 0.35; // spines sit packed, the way they would on a real shelf

/** Widths are normalised so the row fills the shelf run exactly. */
const RAW_W = spines.reduce((n, s) => n + s.w, 0);
const SCALE = (SHELF.to - SHELF.from - GAP * (spines.length - 1)) / RAW_W;

/** Flat where it leaves the label, flat where it arrives, curved in between. */
const strand = (y: number) =>
  `M ${FROM_X} ${y} C ${FROM_X + 24} ${y} ${JOIN.x - 26} ${JOIN.y} ${JOIN.x} ${JOIN.y}`;

const beam = `M ${JOIN.x} ${JOIN.y} L ${SHELF.to} ${JOIN.y}`;

/** One viewBox unit, expressed against the container. */
const u = (n: number) => `${((n / VB.w) * 100).toFixed(4)}cqw`;
const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(3)}%`;

/**
 * Each spine carries its width twice: `--w` as a length for the fixed layout,
 * and `--fw` unitless so it can be a flex-grow ratio when the row goes
 * full-width on a phone.
 */
const spineStyle = (s: { w: number; h: number }, i: number) =>
  `--w: ${u(s.w * SCALE)}; --fw: ${(s.w * SCALE).toFixed(3)}; --h: ${u(s.h)}; --t: ${Math.pow(i / (spines.length - 1), 0.55).toFixed(4)}`;
---

<figure class="conf">
  <svg
    class="conf-art"
    viewBox={`0 0 ${VB.w} ${VB.h}`}
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
  >
    <defs>
      <linearGradient
        id="conf-beam"
        x1={JOIN.x}
        y1="0"
        x2={SHELF.to}
        y2="0"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0" stop-color="#eaf8fe" />
        <stop offset="0.16" stop-color="#5cc9ee" />
        <stop offset="0.62" stop-color="#00a4dc" />
        <stop offset="1" stop-color="#00a4dc" stop-opacity="0.15" />
      </linearGradient>

      <filter id="conf-soft" x="-10%" y="-600%" width="120%" height="1300%">
        <feGaussianBlur stdDeviation="1.5" />
      </filter>
    </defs>

    {sources.map((s) => <path class="conf-strand" d={strand(s.y)} />)}
    {
      sources.map((s, i) => (
        <path
          class="conf-travel"
          d={strand(s.y)}
          pathLength="100"
          style={`--delay: ${(i * 1.1).toFixed(2)}s`}
        />
      ))
    }

    <path class="conf-bloom" d={beam} filter="url(#conf-soft)" />
    <path class="conf-beam" d={beam} />
  </svg>

  <ul class="conf-sources">
    {
      sources.map((s) => (
        <li class="conf-source" style={`--y: ${pct(s.y, VB.h)}`}>
          {s.label}
        </li>
      ))
    }
  </ul>

  <div
    class="conf-shelf"
    aria-hidden="true"
    style={`--left: ${pct(SHELF.from, VB.w)}; --right: ${pct(VB.w - SHELF.to, VB.w)}; --base: ${pct(VB.h - JOIN.y, VB.h)}; --gap: ${u(GAP)}`}
  >
    {
      spines.map((s, i) => <span class="conf-spine" style={spineStyle(s, i)} />)
    }
  </div>

  <div
    class="conf-shelf is-reflection"
    aria-hidden="true"
    style={`--left: ${pct(SHELF.from, VB.w)}; --right: ${pct(VB.w - SHELF.to, VB.w)}; --base: ${pct(JOIN.y, VB.h)}; --gap: ${u(GAP)}`}
  >
    {
      spines.map((s, i) => <span class="conf-spine" style={spineStyle(s, i)} />)
    }
  </div>

  <figcaption
    class="conf-result"
    style={`--x: ${pct(SHELF.from, VB.w)}; --y: ${pct(10, VB.h)}`}
  >
    One library
  </figcaption>
</figure>
