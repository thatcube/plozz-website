---
import { HEADLINE_BADGES } from '../data/site';
---

{/* Two-tone badges, the same shape as the ones in the Plozz repo README. */}
<ul class="badges">
  {HEADLINE_BADGES.map((badge) => (
    <li class="badge">
      <span class="badge-label">{badge.label}</span>
      <span class="badge-value">{badge.value}</span>
    </li>
  ))}
</ul>
