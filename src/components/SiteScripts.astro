---
// Shared behaviour for every page: the header that gets out of the way on the
// way down, and the live GitHub star count.
---

<script>
  /**
   * Promote images that were parked for the viewport.
   *
   * Native lazy loading gets this backwards on a slow connection: the browser
   * widens its "close enough to load" threshold when bandwidth is scarce, so
   * every marquee tile started downloading a second into the page and split the
   * pipe with the LCP image. On a 400kbps desktop that dragged largest
   * contentful paint out past 23s.
   *
   * These load on approach instead, 800px ahead of the viewport, so they are in
   * place before they are scrolled to but never compete with the hero.
   */
  const promote = (img) => {
    const picture = img.closest('picture[data-lazy]');
    if (!picture) return;

    picture.querySelectorAll('source[data-srcset]').forEach((source) => {
      source.srcset = source.dataset.srcset;
      delete source.dataset.srcset;
    });

    if (img.dataset.src) {
      img.src = img.dataset.src;
      delete img.dataset.src;
    }

    /*
     * Hand the fetch over to the browser immediately. These still carry
     * loading="lazy" as a no-JS safety net, but a marquee tile can sit far
     * along a very wide track, and native lazy loading keeps deferring it there
     * — the transform animation that eventually brings it into view does not
     * reliably re-trigger the check, which left blank tiles drifting past. By
     * this point the section is already close to the viewport, so eager is
     * exactly right.
     */
    img.loading = 'eager';

    delete picture.dataset.lazy;
  };

  if ('IntersectionObserver' in window) {
    /*
     * The marquee is watched as one block rather than tile by tile. Its track
     * is a transform animation, and a compositor-driven transform does not
     * reliably re-fire an observer as a tile slides into view — watching them
     * individually left blank tiles drifting through the row. Approaching the
     * section loads the whole row at once, which is also cheap: the second copy
     * of the track reuses the first copy's URLs straight from cache.
     */
    const groupObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target
            .querySelectorAll('picture[data-lazy] img[data-src]')
            .forEach(promote);
          groupObserver.unobserve(entry.target);
        }
      },
      { rootMargin: '800px 0px' }
    );

    document.querySelectorAll('[data-lazy-group]').forEach((group) => {
      groupObserver.observe(group);
    });

    // Everything else is watched on its own <img>, because the <picture> is
    // display: contents and so has no box for the observer to measure.
    const singles = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          promote(entry.target);
          singles.unobserve(entry.target);
        }
      },
      { rootMargin: '800px 0px' }
    );

    document
      .querySelectorAll('picture[data-lazy] img[data-src]')
      .forEach((img) => {
        if (img.closest('[data-lazy-group]')) return;
        singles.observe(img);
      });
  } else {
    document
      .querySelectorAll('picture[data-lazy] img[data-src]')
      .forEach(promote);
  }

  const header = document.querySelector('.site-header');

  if (header) {
    let previousY = window.scrollY;
    let ticking = false;

    const updateHeader = () => {
      const currentY = Math.max(window.scrollY, 0);
      const scrollingDown = currentY > previousY;

      header.classList.toggle('is-hidden', scrollingDown && currentY > header.offsetHeight);
      previousY = currentY;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHeader);
          ticking = true;
        }
      },
      { passive: true }
    );
  }

  /**
   * The hero shot grows as the page is scrolled.
   *
   * It settles when the shot is centred in the window and all but filling it,
   * leaving a 16px margin, and it never grows past the point where the whole
   * picture still fits — a screenshot with its edges cut off is not a
   * screenshot of anything.
   *
   * It grows downwards, from its own top edge, which is why it can never reach
   * the copy above it. Growing from the centre sent half the growth upwards,
   * and that half is not small: 180px on a 1080p screen and 350px on a 1440p
   * one, against about 90px of clear space, so on every large display the shot
   * climbed straight through the buttons.
   *
   * This is JavaScript rather than a CSS scroll timeline for two reasons.
   * Firefox does not implement scroll-driven animations at all, and it is the
   * browser this is mostly looked at in; a stylesheet-only version worked in
   * Chrome and silently did nothing here. And the size to grow to is the
   * window's width divided by the shot's width, which CSS cannot express —
   * dividing one length by another is not something calc() can do.
   *
   * Growth starts from the shot's natural size, so the page is already correct
   * before this runs. There is no state to restore and nothing to flash.
   */
  const heroShot = document.querySelector('[data-hero-grow]');

  if (heroShot) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const section = heroShot.closest('.hero');

    const GAP = 16; // breathing room either side once it has settled
    const PEAK_GAP = 6; // ...and at the top of the spring's overshoot

    /* The shot may not be drawn at less than three quarters of the resolution
       it was sent at. Past that it is being stretched rather than shown, and a
       screenshot of an interface goes soft in exactly the places — hairlines,
       small type — that make it look like software.

       Without this the growth had no upper bound at all, and a wide monitor
       took it somewhere absurd: 2x on a 1440p screen and 3x on a 4K one, at
       which point a 1152px picture is being painted 3468px wide, well past the
       size it exists at. It looked worse the more screen you had. */
    const SHARPNESS = 0.75;

    /* ...and a limit on the sheer size of the thing, for the case where a
       browser hands back more pixels than the display needs. Sharpness would
       allow the growth to continue; taste would not. */
    const MAX_WIDTH = 1600;

    /* An ease-out-back: it runs 6% past its destination, eases back, and
       settles. That figure is not arbitrary — the resting size already leaves
       only GAP either side, so a bigger bounce would push the edges of the
       shot off the screen on the way there. 1.285 is the constant that puts
       the peak at 6%. Travelled against scroll position rather than time, so
       the movement belongs to the scroll rather than running alongside it. */
    const BACK = 1.285;
    const OVERSHOOT = 1.06;

    const spring = (t) => {
      const u = t - 1;
      return 1 + (BACK + 1) * u * u * u + BACK * u * u;
    };

    /* Layout offset from the top of the document. Walking offsetParent rather
       than reading a bounding rect keeps this honest while the shot is scaled:
       a rect reports the scaled box, so measuring from one would feed the
       scale back into the number that decides the scale. */
    const layoutTop = (node) => {
      let y = 0;
      for (let el = node; el; el = el.offsetParent) y += el.offsetTop;
      return y;
    };

    let target = 1;
    let runway = 1;
    let ticking = false;

    const measure = () => {
      // offsetWidth and offsetHeight are layout values, so they report the
      // shot's natural size no matter what scale is currently applied. Reading
      // the bounding rect instead would feed the scale back into itself.
      const width = heroShot.offsetWidth;
      const height = heroShot.offsetHeight;
      if (!width || !height) return;

      const viewWidth = document.documentElement.clientWidth;
      const viewHeight = window.innerHeight;

      const fit = (gap) =>
        Math.min((viewWidth - gap * 2) / width, (viewHeight - gap * 2) / height);

      /* How much room there is to grow before the picture starts being drawn
         at less resolution than it was sent at.

         naturalWidth is the width the browser picked this image to fill, in CSS
         pixels: for a srcset with width descriptors it is the file's real width
         divided by the density it was chosen at, so the 2296px file selected
         for a 1148px slot on a retina screen reports 1148. That is exactly the
         number wanted here, and it is why devicePixelRatio must not appear in
         this sum — the density is already accounted for, and a denser screen is
         handed a proportionally larger file, so the ratio comes out the same on
         every display. Multiplying by it again said the shot was already twice
         too big for its source and pinned the growth shut on retina screens,
         while leaving every 1x screen working. */
      const slide = heroShot.querySelector('img');
      const source = slide && slide.naturalWidth ? slide.naturalWidth : 0;
      const sharp = source
        ? source / (width * SHARPNESS)
        : Number.POSITIVE_INFINITY;

      /* Room to grow into. The shot grows downwards and a transform takes up no
         space, so nothing below moves aside — the only thing keeping it off the
         next section is the padding the hero reserves, read back here so the
         stylesheet stays the one place that number lives. */
      const room = section
        ? parseFloat(getComputedStyle(section).paddingBottom) || 0
        : 0;

      /* Five ceilings, of two kinds.
         One applies where it comes to rest: the margin it should leave.
         The rest apply at the furthest point the spring reaches — a tighter
         margin it may briefly close to, the resolution it was sent at, the room
         there is below it, and a plain limit on how large a screenshot has any
         business being.
         Dividing the second kind by the overshoot is what keeps the bounce
         honest: without it the peak sails past every one of those limits on
         its way to a resting size that respects them. */
      const peak = Math.min(fit(PEAK_GAP), sharp, MAX_WIDTH / width, 1 + room / height);
      target = Math.max(1, Math.min(fit(GAP), 1 + (peak - 1) / OVERSHOOT));

      /* Finish at the scroll position that puts the shot in the middle of the
         window — the one place a nearly-full-height picture is wholly visible.
         Its centre is measured against the grown height, not the natural one,
         because growth runs downwards from the top edge: the bottom is what
         moves, so the middle ends up lower than it starts. */
      const centre = layoutTop(heroShot) + (height * target) / 2;
      runway = Math.max(160, centre - viewHeight / 2);
    };

    const apply = () => {
      ticking = false;
      const progress = Math.min(1, Math.max(0, window.scrollY / runway));
      const scale = 1 + (target - 1) * spring(progress);
      heroShot.style.setProperty('--hero-grow', String(Math.round(scale * 1e4) / 1e4));
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(apply);
    };

    const start = () => {
      if (still.matches) {
        heroShot.style.removeProperty('--hero-grow');
        window.removeEventListener('scroll', onScroll);
        return;
      }
      measure();
      apply();
      window.addEventListener('scroll', onScroll, { passive: true });
    };

    start();
    still.addEventListener('change', start);

    /* The size the shot may grow to depends on the resolution of the picture
       inside it, which is not known until that picture has arrived. Measure
       again when it does, or the first measurement is taken with no ceiling at
       all. */
    const first = heroShot.querySelector('img');
    if (first && !first.complete) {
      first.addEventListener(
        'load',
        () => {
          if (!still.matches) {
            measure();
            apply();
          }
        },
        { once: true }
      );
    }

    // The shot is 16:9 with a fixed aspect, so a resize changes both how much
    // room there is and how far away the centre is.
    let resizeTimer;
    window.addEventListener(
      'resize',
      () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          if (!still.matches) {
            measure();
            apply();
          }
        }, 120);
      },
      { passive: true }
    );
  }

  const applyGithubStars = (stars) => {
    const formatted = new Intl.NumberFormat('en', {
      notation: stars >= 1000 ? 'compact' : 'standard',
      maximumFractionDigits: 1,
    }).format(stars);

    document.querySelectorAll('[data-github-stars]').forEach((element) => {
      element.textContent = formatted;
    });

    document.querySelectorAll('[data-github-stars-badge]').forEach((element) => {
      element.setAttribute('aria-label', `${stars.toLocaleString()} GitHub stars`);
    });

    document.querySelectorAll('.github-link').forEach((element) => {
      element.setAttribute('aria-label', `GitHub — ${stars.toLocaleString()} stars`);
    });
  };

  const cacheKey = 'plozz-github-stars';
  const cacheLifetime = 6 * 60 * 60 * 1000;

  try {
    const cached = JSON.parse(localStorage.getItem(cacheKey) ?? 'null');

    if (cached && Date.now() - cached.savedAt < cacheLifetime) {
      applyGithubStars(cached.stars);
    } else {
      fetch('https://api.github.com/repos/thatcube/Plozz', {
        headers: { Accept: 'application/vnd.github+json' },
      })
        .then((response) => {
          if (!response.ok) throw new Error(`GitHub returned ${response.status}`);
          return response.json();
        })
        .then((repository) => {
          const stars = repository.stargazers_count;
          if (!Number.isInteger(stars)) return;

          applyGithubStars(stars);
          localStorage.setItem(cacheKey, JSON.stringify({ stars, savedAt: Date.now() }));
        })
        .catch(() => {});
    }
  } catch {
    // Keep the build-time count when storage or the API is unavailable.
  }
</script>
