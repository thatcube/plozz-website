---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Stage from '../components/Stage.astro';
import Showcase from '../components/Showcase.astro';
import Shot from "../components/Shot.astro";
import { STAGE, FIGURE } from "../data/imageSizes";

const title = "Plex client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Plex client for Apple TV, iPhone and iPad. Plex Home users get their own profile, your watchlist comes with you, and it connects to your server directly rather than through a relay.";
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      title={"Your Plex Home, on the television."}
      lead={"Everyone you’ve added to Plex Home gets their own profile here, with the libraries they’re allowed and the PIN they already use."}
    />

    <Stage
      title={"Your library, at whatever size suits you"}
      caption={"Rows, posters and spacing are per profile, so one person’s wall of small covers isn’t everyone’s."}
    >
      <Shot
        name="plozz-tv-library"
        alt="A Plex TV Shows library in Plozz on Apple TV, showing a grid of poster art"
        sizes={STAGE}
        loading="eager"
        fetchpriority="high"
      />
    </Stage>

    <Showcase
      question={"It talks to your server, not through Plex"}
      detail={"Plex offers a list of ways to reach a server: on your own network, across the internet, or bounced through a relay when nothing else works. Plozz sorts that list and takes the most direct one it can actually reach, so a server sitting in the next room is used like one."}
      flip
    >
      <Shot
        name="plozz-tv-oppenheimer"
        alt="A film detail page in Plozz on Apple TV, showing full-bleed artwork behind the title, rating and playback controls"
        sizes={FIGURE}
        class="shot"
      />
    </Showcase>

    <Closer secondaryHref="/features" secondaryLabel="Everything it does" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
