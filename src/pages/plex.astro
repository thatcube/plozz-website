---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import SubtitleLab from '../components/SubtitleLab.astro';
import FactSection from '../components/FactSection.astro';
import { TESTFLIGHT_URL } from '../data/site';

const title = "Plex client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Plex client for Apple TV, iPhone and iPad. Direct play instead of transcoding, and subtitle search without a Plex Pass.";

const compatibility = [
  {
    "name": "Video",
    "chips": [
      "HEVC",
      "H.264",
      "VP9",
      "AV1"
    ]
  },
  {
    "name": "HDR",
    "chips": [
      "Dolby Vision P5",
      "Dolby Vision P8",
      "HDR10",
      "HLG"
    ]
  },
  {
    "name": "Badges",
    "chips": [
      "Dolby Vision",
      "Atmos",
      "Digital+",
      "DTS",
      "4K",
      "5.1",
      "7.1"
    ]
  },
  {
    "name": "Scrub thumbnails",
    "value": "Plex BIF thumbnails."
  },
  {
    "name": "One library",
    "value": "Merges with Jellyfin, Emby and network shares, or keeps its own rows."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Plex"}
      title={"A Plex client that leaves your server alone."}
      lead={"Files direct play instead of transcoding, and your Plex library sits in the same place as every other server you own."}
    />

    <Showcase
      question={"Will it wreck my server?"}
      answer={"No. Plozz opens the file itself."}
      detail={"Matroska is demuxed on the device, so Plex never re-encodes anything."}
      panel
    >
      <ul class="proof">
        <li><span>Dolby Vision</span><span>Profiles 5 and 8</span></li>
        <li><span>Dolby Atmos</span><span>Passed through untouched</span></li>
        <li><span>TrueHD and DTS</span><span>Bridged to lossless FLAC</span></li>
        <li><span>Your server</span><span>Sends the file, nothing more</span></li>
      </ul>
    </Showcase>

    <Showcase
      question={"Can I make the subtitles readable?"}
      answer={"Plozz draws its own, so they look the same on every server."}
      detail={"Seven typefaces, two of them made for people who find subtitles hard to read."}
      flip
    >
      <SubtitleLab />
    </Showcase>

    <Showcase
      question={"Do I need a Plex Pass?"}
      answer={"Not for the subtitles."}
      detail={"Plozz reads the Plex subtitle catalogue directly, so searching and downloading works on a free account. Skip-intro markers are the one thing that still needs a Pass."}
      panel
    >
      <ul class="proof">
        <li><span>Subtitle search</span><span>Works on a free account</span></li>
        <li><span>Subtitle styling</span><span>Always yours, never the server’s</span></li>
        <li><span>Skip intros</span><span>Needs Plex Pass markers</span></li>
        <li><span>Plex Home</span><span>Each person gets their own profile</span></li>
      </ul>
    </Showcase>

    <FactSection
      title="Compatibility"
      lead={"What plays without your server lifting a finger."}
      facts={compatibility}
    />

    <section class="closer" aria-labelledby="page-closer">
      <div class="container">
        <h2 id="page-closer">Free forever.<br />Open source.</h2>
        <p>No subscription and no paid tier. GPL-3.0 on GitHub.</p>
        <div class="closer-cta">
          <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
            Join the TestFlight beta
          </a>
          <a class="btn btn-light btn-lg" href="/features">The questions people ask</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
