---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import FactSection from '../components/FactSection.astro';

const title = "Plex client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Plex client for Apple TV, iPhone and iPad. Direct play 4K HDR without transcoding, with subtitle search and styling built into the player.";

const compatibility = [
  {
    "name": "Video",
    "chips": [
      "HEVC",
      "H.264",
      "VP9",
      "AV1"
    ]
  },
  {
    "name": "HDR",
    "chips": [
      "Dolby Vision P5",
      "Dolby Vision P8",
      "HDR10",
      "HLG"
    ]
  },
  {
    "name": "Badges",
    "chips": [
      "Dolby Vision",
      "Atmos",
      "Digital+",
      "DTS",
      "4K",
      "5.1",
      "7.1"
    ]
  },
  {
    "name": "Scrub thumbnails",
    "value": "Plex BIF thumbnails."
  },
  {
    "name": "One library",
    "value": "Merges with Jellyfin, Emby and network shares, or keeps its own rows."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Plex"}
      title={"A Plex client that leaves your server alone."}
    />

    <Showcase
      question={"Will it wreck my server?"}
    >
      <ul class="proof">
        <li><span>Dolby Vision</span><span>Profiles 5, 7, 8.1 and 8.4</span></li>
        <li><span>Dolby Atmos</span><span>Stream-copied from E-AC-3, not re-encoded</span></li>
        <li><span>TrueHD and DTS-HD MA</span><span>Play free, bridged to surround or lossless FLAC</span></li>
        <li><span>Your server</span><span>Hands over the file, nothing more</span></li>
      </ul>
    </Showcase>

    <Showcase
      question={"Can I make the subtitles readable?"}
      flip
    >
      <img
        class="shot"
        src="/screenshots/plozz-tv-subtitles.webp"
        alt="The subtitle style panel open during playback, with OpenDyslexic selected and the subtitle rendered in it"
        width="2000"
        height="1125"
        loading="lazy"
        decoding="async"
      />
    </Showcase>

    <Showcase
      question={"What you get with Plex"}
    >
      <ul class="proof">
        <li><span>Subtitle search</span><span>Find and load one from inside the player</span></li>
        <li><span>Subtitle styling</span><span>Always yours, never the server’s</span></li>
        <li><span>Skip intros</span><span>Reads the markers your server provides</span></li>
        <li><span>Plex Home</span><span>Each person gets their own profile</span></li>
      </ul>
    </Showcase>

    <FactSection
      title="Compatibility"
      facts={compatibility}
    />

    <Closer secondaryHref="/features" secondaryLabel="The questions people ask" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
