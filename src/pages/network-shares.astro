---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Stage from '../components/Stage.astro';
import Showcase from '../components/Showcase.astro';
import Shot from "../components/Shot.astro";
import { STAGE, FIGURE } from "../data/imageSizes";

const title = "Play a network share on Apple TV — SMB, NFS and WebDAV — Plozz";
const description = "Point Plozz at a folder on your NAS over SMB, NFS or WebDAV and it builds the library itself. No Plex, no Jellyfin, no Emby, nothing to install on the server.";
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      title={"A folder of films is a library."}
      lead={"Point Plozz at a share over SMB, NFS or WebDAV and it does the rest: finds the artwork, works out the seasons, and remembers where you stopped. Nothing gets installed on the other end."}
    />

    <Stage
      title={"Artwork and episodes, from a folder"}
      caption={"Plozz keeps the library itself — covers, descriptions, seasons and your progress — so a share ends up looking like everything else on the home screen."}
    >
      <Shot
        name="plozz-tv-episodes"
        alt="A season and episode list in Plozz on Apple TV, built from a network share"
        sizes={STAGE}
        loading="eager"
        fetchpriority="high"
      />
    </Stage>

    <Showcase
      question={"Nothing to install, nothing to maintain"}
      detail={"No server to keep running, nothing to update, and no library scan waiting on someone else’s hardware. Plozz looks for shares on your network on its own, and a share sits beside your servers on the home screen rather than off in a corner of its own."}
      flip
    >
      <Shot
        name="plozz-tv-mario"
        alt="A film detail page in Plozz on Apple TV, built from files on a network share"
        sizes={FIGURE}
        class="shot"
      />
    </Showcase>

    <Closer secondaryHref="/features" secondaryLabel="Everything it does" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
