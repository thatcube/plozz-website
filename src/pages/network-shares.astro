---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import FactSection from '../components/FactSection.astro';
import { TESTFLIGHT_URL } from '../data/site';

const title = "Play SMB, NFS, WebDAV, SFTP and FTP on Apple TV — Plozz";
const description = "Plozz plays video straight off a network share on Apple TV, iPhone and iPad. SMB3, NFS, WebDAV, SFTP with key auth, FTP over TLS. No media server needed.";

const facts0 = [
  {
    "name": "SMB",
    "value": "SMB3 only. Plozz refuses SMB1 and SMB2 rather than quietly falling back."
  },
  {
    "name": "NFS",
    "value": "Mount an export and browse it like any other source."
  },
  {
    "name": "WebDAV",
    "value": "A URL and credentials."
  },
  {
    "name": "SFTP",
    "chips": [
      "Password",
      "OpenSSH key",
      "PEM key"
    ]
  },
  {
    "name": "FTP",
    "chips": [
      "Anonymous",
      "Named",
      "Explicit TLS",
      "Implicit TLS",
      "Cert pinning"
    ]
  }
];

const facts1 = [
  {
    "name": "Sidecar subtitles",
    "chips": [
      ".srt",
      ".ass",
      ".ssa",
      ".vtt"
    ]
  },
  {
    "name": "Where it looks",
    "value": "The same folder, and a Subs folder beside it."
  },
  {
    "name": "Merged in",
    "value": "A share sits in the same Home and Search as your servers."
  }
];

const facts2 = [
  {
    "name": "No transcode",
    "value": "There is nothing in the middle to re-encode anything."
  },
  {
    "name": "Up Next lead time",
    "chips": [
      "15s",
      "20s",
      "30s",
      "45s",
      "60s"
    ]
  },
  {
    "name": "Why the lead time",
    "value": "Loose files carry no credits markers, so you pick when the card appears."
  },
  {
    "name": "Resume",
    "value": "Progress is kept by Plozz and follows you across your devices."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Network shares"}
      title={"A folder of films is a perfectly good media library."}
      lead={"No media server to install, nothing to scan, nothing in the middle re-encoding your files."}
    />

    <FactSection
      title={"Protocols"}
      facts={facts0}
      panel
    />

    <FactSection
      title={"Reading a share"}
      facts={facts1}
    />

    <FactSection
      title={"Playing from it"}
      facts={facts2}
      panel
    />

    <section class="closer" aria-labelledby="page-closer">
      <div class="container">
        <h2 id="page-closer">Free forever.<br />Open source.</h2>
        <p>No subscription and no paid tier. GPL-3.0 on GitHub.</p>
        <div class="closer-cta">
          <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
            Join the TestFlight beta
          </a>
          <a class="btn btn-light btn-lg" href={"/features"}>See every setting</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
