---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import Showcase from '../components/Showcase.astro';
import SubtitleLab from '../components/SubtitleLab.astro';
import { GITHUB_URL, TESTFLIGHT_URL, SITE } from '../data/site';

const heroScreenshots = [
  {
    src: '/screenshots/plozz-tv.webp',
    alt: 'Plozz movie details screen on Apple TV',
    label: 'Movie details',
    width: 1088,
    height: 612,
  },
  {
    src: '/screenshots/plozz-tv-home.webp',
    alt: 'Plozz home screen on Apple TV',
    label: 'Home',
    width: 2000,
    height: 1119,
  },
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Plozz',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'tvOS, iOS, iPadOS',
  description:
    'Plozz is a free, open source media player built in Swift for Apple TV, iPhone, and iPad. Connect Plex, Jellyfin, Emby, SMB, NFS, WebDAV, SFTP, and FTP.',
  url: SITE,
  image: `${SITE}/og-image.png`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  author: { '@type': 'Organization', name: 'thatcube', url: 'https://github.com/thatcube' },
  sameAs: [GITHUB_URL],
};
---

<Layout>
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-copy">
          <h1>A native media player<br />for your servers and shares.</h1>
          <div class="hero-summary">
            <dl class="hero-facts">
              <div>
                <dt>Media servers</dt>
                <dd>Plex · Jellyfin · Emby</dd>
              </div>
              <div>
                <dt>Network shares</dt>
                <dd>SMB · NFS · WebDAV · SFTP · FTP</dd>
              </div>
              <div>
                <dt>Native Swift app</dt>
                <dd>iPhone · iPad · Apple TV</dd>
              </div>
            </dl>
            <div class="hero-actions">
              <p>Free forever · Open source</p>
              <div class="hero-cta">
                <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
                  <Icon name="simple-icons:apple" />
                  Join the TestFlight beta
                </a>
                <a class="btn btn-light btn-lg" href={GITHUB_URL} target="_blank" rel="noopener">
                  <Icon name="simple-icons:github" />
                  GitHub
                </a>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-devices" data-hero-gallery>
          <div class="tv-frame device-tv">
            {heroScreenshots.map((screenshot, index) => (
              <img
                class:list={['hero-slide', { 'is-active': index === 0 }]}
                src={screenshot.src}
                alt={screenshot.alt}
                width={screenshot.width}
                height={screenshot.height}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={index === 0 ? 'high' : 'auto'}
                data-hero-slide
                data-slide-label={screenshot.label}
              />
            ))}
          </div>
          <div class="hero-gallery-status" aria-live="polite">
            <span data-gallery-label>{heroScreenshots[0].label}</span>
            <span class="hero-gallery-control">
              <span><span data-gallery-index>1</span> of {heroScreenshots.length}</span>
              <button type="button" data-gallery-toggle>Pause</button>
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="sources" id="sources" aria-labelledby="sources-heading">
      <div class="container">
        <div class="sources-intro">
          <h2 id="sources-heading">Everything you<br />already have.</h2>
          <p>Plozz plays straight from all of it, without asking a server to transcode anything first.</p>
        </div>
        <ul class="ledger">
          <li class="ledger-row">
            <a href="/jellyfin">
              <img class="lockup-jellyfin" src="/providers/jellyfin.svg" alt="Jellyfin" />
              <span class="ledger-go" aria-hidden="true"></span>
            </a>
          </li>
          <li class="ledger-row">
            <a href="/plex">
              <img class="lockup-plex" src="/providers/plex.svg" alt="Plex" />
              <span class="ledger-go" aria-hidden="true"></span>
            </a>
          </li>
          <li class="ledger-row">
            <a href="/emby">
              <img class="lockup-emby" src="/providers/emby.png" alt="Emby" />
              <span class="ledger-go" aria-hidden="true"></span>
            </a>
          </li>
          <li class="ledger-row ledger-row-shares">
            <a href="/network-shares">
              <span class="sr-only">Network shares</span>
              <span class="share-chips" aria-hidden="true">
                <span class="chip">SMB</span><span class="chip">NFS</span><span class="chip">WebDAV</span><span class="chip">SFTP</span><span class="chip">FTP</span>
              </span>
              <span class="ledger-go" aria-hidden="true"></span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section class="merge" aria-labelledby="merge-heading">
      <div class="container">
       <div class="panel merge-body">
        <div class="merge-copy">
          <h2 id="merge-heading">Your servers. Your friends&rsquo;. One library.</h2>
          <p>Connect as many as you like. Watch history stays in sync across all of them.</p>
        </div>
        <div class="merge-diagram">
          <ul class="merge-inputs">
            <li>Your Plex</li>
            <li>Your Jellyfin</li>
            <li>A friend&rsquo;s Emby</li>
            <li>The NAS in the closet</li>
          </ul>
          <p class="merge-output">One library</p>
        </div>
       </div>
      </div>
    </section>

    <Showcase
      question="Subtitles you can actually read."
      answer="Plozz draws its own, so they look the same on every server."
      detail="Seven typefaces, two of them made for people who find subtitles hard to read. Then size, position, colour, background and outline, plus a separate brightness for HDR so white text stops searing in a dark room."
      panel
    >
      <SubtitleLab />
    </Showcase>

    <section class="more-link">
      <div class="container">
        <a class="text-link" href="/features">The other questions people ask</a>
      </div>
    </section>

    <section class="icloud-sync" aria-labelledby="icloud-sync-heading">
      <div class="container">
       <div class="panel icloud-body">
        <div>
          <h2 id="icloud-sync-heading">Every screen you own.</h2>
          <p>Apple TV, iPhone and iPad, sharing servers and progress over iCloud. Downloads and Picture in Picture on the ones you carry.</p>
        </div>
        <div class="icloud-devices">
          <div class="icloud-device-slot icloud-ipad-slot">
            <div class="device device-ipad-pro device-spacegray device-landscape">
              <div class="device-frame">
                <img
                  class="device-screen"
                  src="/screenshots/plozz-ipad.webp"
                  alt="Plozz on iPad"
                  width="1084"
                  height="757"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="device-btns"></div>
              <div class="device-sensors"></div>
            </div>
          </div>
          <div class="icloud-device-slot icloud-iphone-slot">
            <div class="device device-iphone-14-pro device-black">
              <div class="device-frame">
                <img
                  class="device-screen"
                  src="/screenshots/plozz-iphone.webp"
                  alt="Plozz on iPhone"
                  width="738"
                  height="1603"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="device-stripe"></div>
              <div class="device-header"></div>
              <div class="device-sensors"></div>
              <div class="device-btns"></div>
              <div class="device-power"></div>
              <div class="device-home"></div>
            </div>
          </div>
          <div class="icloud-mark" aria-hidden="true">
            <Icon name="ph:cloud-check" />
          </div>
        </div>
       </div>
      </div>
    </section>

    <section class="closer" aria-labelledby="closer-heading">
      <div class="container">
        <h2 id="closer-heading">Free forever.<br />Open source.</h2>
        <p>No subscription and no paid tier. GPL-3.0 on GitHub.</p>
        <div class="closer-cta">
          <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
            <Icon name="simple-icons:apple" />
            Join the TestFlight beta
          </a>
          <a class="btn btn-light btn-lg" href={GITHUB_URL} target="_blank" rel="noopener">
            <Icon name="simple-icons:github" />
            Read the source
          </a>
        </div>
      </div>
    </section>

  </main>

  <SiteFooter />

  <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
  <SiteScripts />
  <script>
    const gallery = document.querySelector('[data-hero-gallery]');

    if (gallery) {
      const slides = [...gallery.querySelectorAll('[data-hero-slide]')];
      const label = gallery.querySelector('[data-gallery-label]');
      const indexLabel = gallery.querySelector('[data-gallery-index]');
      const toggle = gallery.querySelector('[data-gallery-toggle]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let activeIndex = 0;
      let timer;
      let paused = reducedMotion.matches;

      const showSlide = (index) => {
        activeIndex = index;

        slides.forEach((slide, slideIndex) => {
          slide.classList.toggle('is-active', slideIndex === activeIndex);
        });

        label.textContent = slides[activeIndex].dataset.slideLabel;
        indexLabel.textContent = String(activeIndex + 1);
      };

      const stop = () => {
        window.clearInterval(timer);
      };

      const start = () => {
        stop();
        if (paused || document.hidden || reducedMotion.matches) return;
        timer = window.setInterval(() => showSlide((activeIndex + 1) % slides.length), 7000);
      };

      toggle.addEventListener('click', () => {
        paused = !paused;
        toggle.textContent = paused ? 'Play' : 'Pause';
        start();
      });

      gallery.addEventListener('mouseenter', () => {
        stop();
      });
      gallery.addEventListener('mouseleave', () => {
        start();
      });
      gallery.addEventListener('focusin', () => {
        stop();
      });
      gallery.addEventListener('focusout', () => {
        start();
      });
      document.addEventListener('visibilitychange', start);
      reducedMotion.addEventListener('change', () => {
        if (reducedMotion.matches) {
          paused = true;
          toggle.textContent = 'Play';
        }
        start();
      });

      toggle.textContent = paused ? 'Play' : 'Pause';
      start();
    }
  </script>
</Layout>
