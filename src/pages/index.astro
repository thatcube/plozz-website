---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const GITHUB_URL = 'https://github.com/thatcube/Plozz';
const DONATE_URL = 'https://github.com/sponsors/thatcube';
const TESTFLIGHT_URL = 'https://testflight.apple.com/join/EKfReNMu';
const SITE = 'https://plozz.app';
const heroScreenshots = [
  {
    src: '/screenshots/plozz-tv.webp',
    alt: 'Plozz movie details screen on Apple TV',
    label: 'Movie details',
    width: 1088,
    height: 612,
  },
  {
    src: '/screenshots/plozz-tv-home.webp',
    alt: 'Plozz home screen on Apple TV',
    label: 'Home',
    width: 2000,
    height: 1119,
  },
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Plozz',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'iOS, iPadOS, tvOS',
  description:
    'Plozz is a free, open source media player built in Swift for iPhone, iPad, and Apple TV. Connect Plex, Jellyfin, Emby, SMB, NFS, WebDAV, SFTP, and FTP.',
  url: SITE,
  image: `${SITE}/og-image.png`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  author: { '@type': 'Organization', name: 'thatcube', url: 'https://github.com/thatcube' },
  sameAs: [GITHUB_URL],
};
---

<Layout>
  <header class="site-header">
    <div class="container">
      <a class="site-brand" href="/" aria-label="Plozz home">
        <img src="/logo.svg" alt="" width="32" height="32" />
        <span>Plozz</span>
      </a>
      <nav aria-label="Main navigation">
        <a class="github-link" href={GITHUB_URL} target="_blank" rel="noopener">
          <Icon name="simple-icons:github" />
          <span class="sr-only">GitHub</span>
          <span class="github-stars" data-github-stars-badge aria-label="7 GitHub stars">
            <span data-github-stars>7</span>
            <span>stars</span>
          </span>
        </a>
        <a class="header-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">TestFlight</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-copy">
          <h1>A native media player<br />for your servers and shares.</h1>
          <div class="hero-summary">
            <dl class="hero-facts">
              <div>
                <dt>Media servers</dt>
                <dd>Plex · Jellyfin · Emby</dd>
              </div>
              <div>
                <dt>Network shares</dt>
                <dd>SMB · NFS · WebDAV · SFTP · FTP</dd>
              </div>
              <div>
                <dt>Native Swift app</dt>
                <dd>iPhone · iPad · Apple TV</dd>
              </div>
            </dl>
            <div class="hero-actions">
              <p>Free forever · Open source</p>
              <div class="hero-cta">
                <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
                  <Icon name="simple-icons:apple" />
                  Join the TestFlight beta
                </a>
                <a class="btn btn-light btn-lg" href={GITHUB_URL} target="_blank" rel="noopener">
                  <Icon name="simple-icons:github" />
                  GitHub
                </a>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-devices" data-hero-gallery>
          <div class="tv-frame device-tv">
            {heroScreenshots.map((screenshot, index) => (
              <img
                class:list={['hero-slide', { 'is-active': index === 0 }]}
                src={screenshot.src}
                alt={screenshot.alt}
                width={screenshot.width}
                height={screenshot.height}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={index === 0 ? 'high' : 'auto'}
                data-hero-slide
                data-slide-label={screenshot.label}
              />
            ))}
          </div>
          <div class="hero-gallery-status" aria-live="polite">
            <span data-gallery-label>{heroScreenshots[0].label}</span>
            <span class="hero-gallery-control">
              <span><span data-gallery-index>1</span> of {heroScreenshots.length}</span>
              <button type="button" data-gallery-toggle>Pause</button>
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="sources" id="sources" aria-labelledby="sources-heading">
      <div class="container">
        <div class="sources-intro">
          <h2 id="sources-heading">Everything you<br />already have.</h2>
          <p>Plozz finds servers on your network and signs you in without typing on a remote.</p>
        </div>
        <dl class="ledger">
          <div class="ledger-row">
            <dt><img class="lockup-jellyfin" src="/providers/jellyfin.svg" alt="Jellyfin" /></dt>
            <dd>Quick Connect</dd>
          </div>
          <div class="ledger-row">
            <dt><img class="lockup-plex" src="/providers/plex.svg" alt="Plex" /></dt>
            <dd>Plex Link</dd>
          </div>
          <div class="ledger-row">
            <dt><img class="lockup-emby" src="/providers/emby.png" alt="Emby" /></dt>
            <dd>Password sign-in</dd>
          </div>
          <div class="ledger-row ledger-row-shares">
            <dt><span>SMB</span><span>NFS</span><span>WebDAV</span><span>SFTP</span><span>FTP</span></dt>
            <dd>Address and credentials</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="merge" aria-labelledby="merge-heading">
      <div class="container">
        <div class="merge-copy">
          <h2 id="merge-heading">Your servers. Your friends&rsquo;. One library.</h2>
          <p>Connect as many as you like. Plozz merges them into a single library and keeps watch history in sync across every one.</p>
        </div>
        <div class="merge-diagram">
          <ul class="merge-inputs">
            <li>Your Plex</li>
            <li>Your Jellyfin</li>
            <li>A friend&rsquo;s Emby</li>
            <li>The NAS in the closet</li>
          </ul>
          <p class="merge-output">One library</p>
        </div>
      </div>
    </section>

    <section class="plays" aria-labelledby="plays-heading">
      <div class="container">
        <div class="plays-intro">
          <h2 id="plays-heading">Movies, shows, anime, and music.</h2>
          <p>Every play scrobbles to the service you already use. Music gets a real player &mdash; queue, now playing, and background audio.</p>
        </div>
        <dl class="plays-grid">
          <div>
            <dt>Movies</dt>
            <dd>Trakt · Simkl</dd>
          </div>
          <div>
            <dt>Shows</dt>
            <dd>Trakt · Simkl</dd>
          </div>
          <div>
            <dt>Anime</dt>
            <dd>AniList · MyAnimeList</dd>
          </div>
          <div>
            <dt>Music</dt>
            <dd>Last.fm</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="icloud-sync" aria-labelledby="icloud-sync-heading">
      <div class="container">
        <div>
          <h2 id="icloud-sync-heading">Every screen you own.</h2>
          <p>Your servers and playback progress sync over iCloud. Start on Apple TV, finish on your phone.</p>
        </div>
        <div class="icloud-devices">
          <div class="icloud-device-slot icloud-ipad-slot">
            <div class="device device-ipad-pro device-spacegray device-landscape">
              <div class="device-frame">
                <img
                  class="device-screen"
                  src="/screenshots/plozz-ipad.webp"
                  alt="Plozz on iPad"
                  width="1084"
                  height="757"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="device-btns"></div>
              <div class="device-sensors"></div>
            </div>
          </div>
          <div class="icloud-device-slot icloud-iphone-slot">
            <div class="device device-iphone-14-pro device-black">
              <div class="device-frame">
                <img
                  class="device-screen"
                  src="/screenshots/plozz-iphone.webp"
                  alt="Plozz on iPhone"
                  width="738"
                  height="1603"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="device-stripe"></div>
              <div class="device-header"></div>
              <div class="device-sensors"></div>
              <div class="device-btns"></div>
              <div class="device-power"></div>
              <div class="device-home"></div>
            </div>
          </div>
          <div class="icloud-mark" aria-hidden="true">
            <Icon name="ph:cloud-check" />
          </div>
        </div>
      </div>
    </section>

    <section class="closer" aria-labelledby="closer-heading">
      <div class="container">
        <h2 id="closer-heading">Free forever.<br />Open source.</h2>
        <p>No subscription, no paid tier, no upsell. The whole app is GPL-3.0 on GitHub.</p>
        <div class="closer-cta">
          <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
            <Icon name="simple-icons:apple" />
            Join the TestFlight beta
          </a>
          <a class="btn btn-light btn-lg" href={GITHUB_URL} target="_blank" rel="noopener">
            <Icon name="simple-icons:github" />
            Read the source
          </a>
        </div>
      </div>
    </section>

  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-brand">
        <img src="/logo.svg" alt="" width="22" height="22" />
        <span>Plozz</span>
      </div>
      <div class="footer-links">
        <a href="/privacy">Privacy</a>
        <a class="github-link" href={GITHUB_URL} target="_blank" rel="noopener">
          <Icon name="simple-icons:github" />
          <span class="sr-only">GitHub</span>
          <span class="github-stars" data-github-stars-badge aria-label="7 GitHub stars">
            <span data-github-stars>7</span>
            <span>stars</span>
          </span>
        </a>
        <a href={`${GITHUB_URL}/issues`} target="_blank" rel="noopener">Send feedback</a>
        <a class="btn btn-ghost btn-sm" href={DONATE_URL} target="_blank" rel="noopener">
          <Icon name="ph:heart" />
          Donate
        </a>
      </div>
      <div>© {new Date().getFullYear()} Plozz · GPL-3.0</div>
    </div>
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
  <script>
    const header = document.querySelector('.site-header');

    if (header) {
      let previousY = window.scrollY;
      let ticking = false;

      const updateHeader = () => {
        const currentY = Math.max(window.scrollY, 0);
        const scrollingDown = currentY > previousY;

        header.classList.toggle('is-hidden', scrollingDown && currentY > header.offsetHeight);
        previousY = currentY;
        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            window.requestAnimationFrame(updateHeader);
            ticking = true;
          }
        },
        { passive: true }
      );
    }

    const applyGithubStars = (stars) => {
      const formatted = new Intl.NumberFormat('en', {
        notation: stars >= 1000 ? 'compact' : 'standard',
        maximumFractionDigits: 1,
      }).format(stars);

      document.querySelectorAll('[data-github-stars]').forEach((element) => {
        element.textContent = formatted;
      });

      document.querySelectorAll('[data-github-stars-badge]').forEach((element) => {
        element.setAttribute('aria-label', `${stars.toLocaleString()} GitHub stars`);
      });

      document.querySelectorAll('.github-link').forEach((element) => {
        element.setAttribute('aria-label', `GitHub — ${stars.toLocaleString()} stars`);
      });
    };

    const cacheKey = 'plozz-github-stars';
    const cacheLifetime = 6 * 60 * 60 * 1000;

    try {
      const cached = JSON.parse(localStorage.getItem(cacheKey) ?? 'null');

      if (cached && Date.now() - cached.savedAt < cacheLifetime) {
        applyGithubStars(cached.stars);
      } else {
        fetch('https://api.github.com/repos/thatcube/Plozz', {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then((response) => {
            if (!response.ok) throw new Error(`GitHub returned ${response.status}`);
            return response.json();
          })
          .then((repository) => {
            const stars = repository.stargazers_count;
            if (!Number.isInteger(stars)) return;

            applyGithubStars(stars);
            localStorage.setItem(cacheKey, JSON.stringify({ stars, savedAt: Date.now() }));
          })
          .catch(() => {});
      }
    } catch {
      // Keep the build-time count when storage or the API is unavailable.
    }

    const gallery = document.querySelector('[data-hero-gallery]');

    if (gallery) {
      const slides = [...gallery.querySelectorAll('[data-hero-slide]')];
      const label = gallery.querySelector('[data-gallery-label]');
      const indexLabel = gallery.querySelector('[data-gallery-index]');
      const toggle = gallery.querySelector('[data-gallery-toggle]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let activeIndex = 0;
      let timer;
      let paused = reducedMotion.matches;

      const showSlide = (index) => {
        activeIndex = index;

        slides.forEach((slide, slideIndex) => {
          slide.classList.toggle('is-active', slideIndex === activeIndex);
        });

        label.textContent = slides[activeIndex].dataset.slideLabel;
        indexLabel.textContent = String(activeIndex + 1);
      };

      const stop = () => {
        window.clearInterval(timer);
      };

      const start = () => {
        stop();
        if (paused || document.hidden || reducedMotion.matches) return;
        timer = window.setInterval(() => showSlide((activeIndex + 1) % slides.length), 7000);
      };

      toggle.addEventListener('click', () => {
        paused = !paused;
        toggle.textContent = paused ? 'Play' : 'Pause';
        start();
      });

      gallery.addEventListener('mouseenter', () => {
        stop();
      });
      gallery.addEventListener('mouseleave', () => {
        start();
      });
      gallery.addEventListener('focusin', () => {
        stop();
      });
      gallery.addEventListener('focusout', () => {
        start();
      });
      document.addEventListener('visibilitychange', start);
      reducedMotion.addEventListener('change', () => {
        if (reducedMotion.matches) {
          paused = true;
          toggle.textContent = 'Play';
        }
        start();
      });

      toggle.textContent = paused ? 'Play' : 'Pause';
      start();
    }
  </script>
</Layout>
