---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import SubtitleLab from '../components/SubtitleLab.astro';
import WarmthLab from '../components/WarmthLab.astro';
import DensityLab from '../components/DensityLab.astro';
import SpoilerLab from '../components/SpoilerLab.astro';
import { TESTFLIGHT_URL } from '../data/site';

const title = 'Plozz features — the media player questions people actually ask';
const description =
  'Does it direct play? Can I skip intros? Can I fix the subtitles? Can I watch offline? The answers, shown rather than listed.';
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow="Features"
      title="The questions people actually ask."
      lead="Every answer below is yes. Here is what each one looks like."
    />

    <Showcase
      question="Will it wreck my server?"
      answer="No. Plozz opens the file itself and plays it as it is."
      detail="Matroska is demuxed on your Apple TV, iPhone or iPad, so nothing upstream re-encodes anything."
      panel
    >
      <ul class="proof">
        <li><span>Dolby Vision</span><span>Profiles 5 and 8</span></li>
        <li><span>Dolby Atmos</span><span>Passed through untouched</span></li>
        <li><span>TrueHD and DTS</span><span>Bridged to lossless FLAC</span></li>
        <li><span>Your server</span><span>Sends the file and goes back to sleep</span></li>
      </ul>
    </Showcase>

    <Showcase
      question="Can I make the subtitles readable?"
      answer="Plozz draws its own, so they look the same on every server."
      detail="Two of the seven typefaces exist specifically for people who find subtitles hard to read."
      flip
    >
      <SubtitleLab />
    </Showcase>

    <Showcase
      question="Does it skip intros?"
      answer="Yes, and you decide how pushy it is about it."
      detail="Uses Plex Pass markers or the Jellyfin Intro Skipper."
      panel
    >
      <ul class="proof">
        <li><span>Off</span><span>Never touch it</span></li>
        <li><span>On</span><span>Show a Skip button</span></li>
        <li><span>Auto (delay)</span><span>Skip after five seconds, cancellable</span></li>
        <li><span>Auto (instant)</span><span>Gone before you notice</span></li>
      </ul>
    </Showcase>

    <Showcase
      question="Watching at 1am?"
      answer="Warm the whole screen down, player included."
      detail="tvOS has no Night Shift and no brightness API, so Plozz tints its own window. Most night modes give up the moment video starts."
      flip
    >
      <WarmthLab />
    </Showcase>

    <Showcase
      question="Can I fit more on screen?"
      answer="Six steps, from a wall of posters to a low-vision layout."
      detail="Density moves card size, spacing and column count together, and it is remembered per profile."
      panel
    >
      <DensityLab />
    </Showcase>

    <Showcase
      question="Will it spoil the next episode?"
      answer="Not if you would rather it did not."
      detail="Unwatched episodes keep their artwork hidden and read as Episode 4 until you have seen them. Ratings can stay hidden too."
      flip
    >
      <SpoilerLab />
    </Showcase>

    <Showcase
      question="Can I watch on a plane?"
      answer="Download on your iPhone or iPad and take it with you."
      detail="Queue a film or a whole show, on Wi-Fi only if you would rather not spend the data."
      panel
    >
      <ul class="proof">
        <li><span>Downloads</span><span>iPhone and iPad</span></li>
        <li><span>Picture in Picture</span><span>Keeps the custom controls and subtitles</span></li>
        <li><span>AirPlay</span><span>Route picker in the player</span></li>
        <li><span>Background audio</span><span>Carries on when the screen locks</span></li>
      </ul>
    </Showcase>

    <Showcase
      question="What are you doing with my data?"
      answer="Nothing. There is no analytics code in the app."
      detail="Crash reporting is off by default, and public builds ship with no reporting endpoint at all."
      flip
    >
      <ul class="proof">
        <li><span>Analytics</span><span>None, anywhere in the codebase</span></li>
        <li><span>Crash reports</span><span>Off unless you turn them on</span></li>
        <li><span>Accounts</span><span>Plozz has none to make</span></li>
        <li><span>Price</span><span>Free, and GPL-3.0 on GitHub</span></li>
      </ul>
    </Showcase>

    <section class="closer" aria-labelledby="features-closer">
      <div class="container">
        <h2 id="features-closer">Free forever.<br />Open source.</h2>
        <p>No subscription and no paid tier. GPL-3.0 on GitHub.</p>
        <div class="closer-cta">
          <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
            Join the TestFlight beta
          </a>
          <a class="btn btn-light btn-lg" href="/">Back to the start</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
