---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Features"}
      title={"The settings are the point."}
      lead={"Most players decide for you. Plozz has an opinion and will happily be overruled."}
    />

    <FactSection
      title={"Subtitles"}
      lead={"Plozz renders its own, so none of this depends on the server."}
      facts={facts0}
      panel
    />

    <FactSection
      title={"Playback"}
      lead={"AetherEngine, an open source FFmpeg engine, running on the device."}
      facts={facts1}
    />

    <FactSection
      title={"How it looks"}
      facts={facts2}
      panel
    />

    <FactSection
      title={"Spoiler protection"}
      lead={"Browse a series you are midway through without learning what happens."}
      facts={facts3}
    />

    <FactSection
      title={"Circadian mode"}
      lead={"tvOS has no Night Shift and no brightness API, so Plozz built one."}
      facts={facts4}
      panel
    />

    <FactSection
      title={"On iPhone and iPad"}
      lead={"Not a scaled-up phone layout. Settings split into panes on iPad."}
      facts={facts5}
    />

    <FactSection
      title={"Household"}
      facts={facts6}
      panel
    />

    <FactSection
      title={"What it does not do"}
      lead={"The part most sites leave out."}
      facts={facts7}
    />

    <section class="closer" aria-labelledby="page-closer">
      <div class="container">
        <h2 id="page-closer">Free forever.<br />Open source.</h2>
        <p>No subscription and no paid tier. GPL-3.0 on GitHub.</p>
        <div class="closer-cta">
          <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
            Join the TestFlight beta
          </a>
          <a class="btn btn-light btn-lg" href={"/"}>Back to the start</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
