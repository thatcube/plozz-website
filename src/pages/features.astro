---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import DensityLab from '../components/DensityLab.astro';
import SpoilerLab from '../components/SpoilerLab.astro';
import DirectPath from '../components/DirectPath.astro';
import Offline from '../components/Offline.astro';
import IntroModes from '../components/IntroModes.astro';
import Nowhere from '../components/Nowhere.astro';
import Shot from "../components/Shot.astro";
import { FIGURE } from "../data/imageSizes";

const title = 'Plozz features — the questions people actually ask';
const description =
  'Does it direct play? Can I skip intros? Can I fix the subtitles? Can I watch offline? The answers, shown rather than listed.';
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow="Features"
      title="The questions people actually ask."
    />

    <Showcase
      question="Will it wreck my server?"
      detail="Nothing upstream re-encodes a thing, so your server sits idle while you watch."
    >
      <DirectPath source="Your server" icon="ph:hard-drives" />
    </Showcase>

    <Showcase
      question="Can I make the subtitles readable?"
      detail="Seven typefaces, two of them built for people who struggle to read subtitles at all. Change any of it mid-scene, without leaving what you're watching."
      flip
    >
      <Shot
        name="plozz-tv-subtitles"
        alt="The subtitle style panel open during playback, with OpenDyslexic selected and the subtitle rendered in it"
        sizes={FIGURE}
        class="shot"
      />
    </Showcase>

    <Showcase
      question="Does it skip intros?"
      detail="Four settings, and the difference between them is what happens to the playhead. Works wherever your server marks its intros and credits."
    >
      <IntroModes />
    </Showcase>

    <Showcase
      question="Can I fit more on screen?"
      detail="Card size, spacing and columns all move together. Every profile remembers its own."
    >
      <DensityLab />
    </Showcase>

    <Showcase
      question="Will it spoil the next episode?"
      detail="Artwork stays hidden and the title just reads Episode 4 until you’ve watched it. Ratings can stay hidden too."
      flip
    >
      <SpoilerLab />
    </Showcase>

    <Showcase
      question="Can I watch on a plane?"
      detail="Queue a film or a whole season on an iPhone or iPad, and stick to Wi-Fi if you’d rather not spend the data. Picture in Picture keeps your subtitles and controls, and the audio carries on when the screen locks."
    >
      <Offline />
    </Showcase>

    <Showcase
      question="What are you doing with my data?"
      detail="No analytics anywhere in the code, no account to make, and crash reporting stays off until you switch it on. Public builds ship without anywhere to send one anyway."
      flip
    >
      <Nowhere />
    </Showcase>

    <Closer secondaryHref="/" secondaryLabel="Back to the start" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
