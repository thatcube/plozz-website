---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import SubtitleLab from '../components/SubtitleLab.astro';
import WarmthLab from '../components/WarmthLab.astro';
import DensityLab from '../components/DensityLab.astro';
import SpoilerLab from '../components/SpoilerLab.astro';

const title = 'Plozz features — the media player questions people actually ask';
const description =
  'Does it direct play? Can I skip intros? Can I fix the subtitles? Can I watch offline? The answers, shown rather than listed.';
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow="Features"
      title="The questions people actually ask."
      lead="Every answer here is yes. This is what that looks like."
    />

    <Showcase
      question="Will it wreck my server?"
      answer="No. Your Apple TV opens the file and plays it."
      detail="Nothing upstream re-encodes a thing, so your server sits idle while you watch."
      panel
    >
      <ul class="proof">
        <li><span>Dolby Vision</span><span>Profiles 5, 7, 8.1 and 8.4</span></li>
        <li><span>Dolby Atmos</span><span>Stream-copied from E-AC-3, not re-encoded</span></li>
        <li><span>TrueHD and DTS-HD MA</span><span>Play free, bridged to surround or lossless FLAC</span></li>
        <li><span>Your server</span><span>Hands over the file, then goes back to sleep</span></li>
      </ul>
    </Showcase>

    <Showcase
      question="Can I make the subtitles readable?"
      answer="Plozz draws its own, so they look the same everywhere."
      detail="Seven typefaces. Two of them were built for people who struggle to read subtitles at all."
      flip
    >
      <SubtitleLab />
    </Showcase>

    <Showcase
      question="Does it skip intros?"
      answer="Yes, and you decide how pushy it gets."
      detail="Works off Plex Pass markers, or the Jellyfin Intro Skipper."
      panel
    >
      <ul class="proof">
        <li><span>Off</span><span>Never touch it</span></li>
        <li><span>On</span><span>Show a Skip button</span></li>
        <li><span>Auto (delay)</span><span>Skip after five seconds, cancellable</span></li>
        <li><span>Auto (instant)</span><span>Gone before you notice</span></li>
      </ul>
    </Showcase>

    <Showcase
      question="Watching at 1am?"
      answer="Warm the whole screen down. The player too."
      detail="Apple gives tvOS no Night Shift and no brightness control, so Plozz tints its own window instead. Most night modes quit the second video starts."
      flip
    >
      <WarmthLab />
    </Showcase>

    <Showcase
      question="Can I fit more on screen?"
      answer="Six steps, from a wall of posters down to five big ones."
      detail="Card size, spacing and columns all move together. Every profile remembers its own."
      panel
    >
      <DensityLab />
    </Showcase>

    <Showcase
      question="Will it spoil the next episode?"
      answer="Not unless you want it to."
      detail="Artwork stays hidden and the title just reads Episode 4 until you’ve watched it. Ratings can stay hidden too."
      flip
    >
      <SpoilerLab />
    </Showcase>

    <Showcase
      question="Can I watch on a plane?"
      answer="Download to your iPhone or iPad first."
      detail="Queue a film or a whole season. Stick to Wi-Fi if you’d rather not spend the data."
      panel
    >
      <ul class="proof">
        <li><span>Downloads</span><span>On iPhone and iPad</span></li>
        <li><span>Picture in Picture</span><span>Keeps the custom controls and subtitles</span></li>
        <li><span>AirPlay</span><span>Route picker in the player</span></li>
        <li><span>Background audio</span><span>Keeps going when the screen locks</span></li>
      </ul>
    </Showcase>

    <Showcase
      question="What are you doing with my data?"
      answer="Nothing. There’s no analytics code in the app at all."
      detail="Crash reporting stays off until you turn it on, and public builds ship without a reporting endpoint anyway."
      flip
    >
      <ul class="proof">
        <li><span>Analytics</span><span>None, anywhere in the codebase</span></li>
        <li><span>Crash reports</span><span>Off until you turn them on</span></li>
        <li><span>Accounts</span><span>There’s no Plozz account to make</span></li>
        <li><span>Price</span><span>Free, and the source is on GitHub</span></li>
      </ul>
    </Showcase>

    <Closer secondaryHref="/" secondaryLabel="Back to the start" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
