---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import SubtitleLab from '../components/SubtitleLab.astro';
import FactSection from '../components/FactSection.astro';

const title = "Jellyfin client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Jellyfin client for Apple TV, iPhone and iPad. Direct plays 4K HDR and Dolby Vision without making Jellyfin transcode. No subscription and no Pro tier.";

const compatibility = [
  {
    "name": "Video",
    "chips": [
      "HEVC",
      "H.264",
      "VP9",
      "AV1"
    ]
  },
  {
    "name": "HDR",
    "chips": [
      "Dolby Vision P5",
      "Dolby Vision P8",
      "HDR10",
      "HLG"
    ]
  },
  {
    "name": "Subtitles",
    "chips": [
      "SRT",
      "ASS",
      "SSA",
      "VTT",
      "PGS",
      "DVB",
      "DVD"
    ]
  },
  {
    "name": "Scrub thumbnails",
    "value": "Jellyfin trickplay tiles."
  },
  {
    "name": "One library",
    "value": "Merges with Plex, Emby and network shares, or keeps its own rows."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Jellyfin"}
      title={"Stop making Jellyfin transcode."}
      lead={"Your Apple TV opens the file and plays it. Your server hands it over, then goes back to sleep."}
    />

    <Showcase
      question={"Will it wreck my server?"}
      answer={"No. Your Apple TV opens the file and plays it."}
      detail={"Nothing upstream re-encodes a thing, so Jellyfin sits idle while you watch."}
      panel
    >
      <ul class="proof">
        <li><span>Dolby Vision</span><span>Profiles 5, 7, 8.1 and 8.4</span></li>
        <li><span>Dolby Atmos</span><span>Stream-copied from E-AC-3, not re-encoded</span></li>
        <li><span>TrueHD and DTS-HD MA</span><span>Play free, bridged to surround or lossless FLAC</span></li>
        <li><span>Your server</span><span>Hands over the file, nothing more</span></li>
      </ul>
    </Showcase>

    <Showcase
      question={"Can I make the subtitles readable?"}
      answer={"Plozz draws its own, so they look the same everywhere."}
      detail={"Seven typefaces. Two were built for people who struggle to read subtitles at all."}
      flip
    >
      <SubtitleLab />
    </Showcase>

    <Showcase
      question={"Does it skip intros?"}
      answer={"Yes, using the markers Jellyfin already has."}
      detail={"Reads Media Segments, or the Intro Skipper plugin."}
      panel
    >
      <ul class="proof">
        <li><span>Off</span><span>Never touch it</span></li>
        <li><span>On</span><span>Show a Skip button</span></li>
        <li><span>Auto (delay)</span><span>Skip after five seconds, cancellable</span></li>
        <li><span>Auto (instant)</span><span>Gone before you notice</span></li>
      </ul>
    </Showcase>

    <FactSection
      title="Compatibility"
      lead={"What plays without your server lifting a finger."}
      facts={compatibility}
    />

    <Closer secondaryHref="/features" secondaryLabel="The questions people ask" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
