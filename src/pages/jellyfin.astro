---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import SubtitleLab from '../components/SubtitleLab.astro';
import FactSection from '../components/FactSection.astro';
import { TESTFLIGHT_URL } from '../data/site';

const title = "Jellyfin client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Jellyfin client for Apple TV, iPhone and iPad. Direct plays your files instead of making Jellyfin transcode them.";

const compatibility = [
  {
    "name": "Video",
    "chips": [
      "HEVC",
      "H.264",
      "VP9",
      "AV1"
    ]
  },
  {
    "name": "HDR",
    "chips": [
      "Dolby Vision P5",
      "Dolby Vision P8",
      "HDR10",
      "HLG"
    ]
  },
  {
    "name": "Subtitles",
    "chips": [
      "SRT",
      "ASS",
      "SSA",
      "VTT",
      "PGS",
      "DVB",
      "DVD"
    ]
  },
  {
    "name": "Scrub thumbnails",
    "value": "Jellyfin trickplay tiles."
  },
  {
    "name": "One library",
    "value": "Merges with Plex, Emby and network shares, or keeps its own rows."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Jellyfin"}
      title={"Stop making Jellyfin transcode."}
      lead={"Plozz opens the file on your Apple TV, iPhone or iPad and plays it as it is. Your server hands over the file and goes back to sleep."}
    />

    <Showcase
      question={"Will it wreck my server?"}
      answer={"No. Plozz opens the file itself."}
      detail={"Matroska is demuxed on the device, so Jellyfin never re-encodes anything."}
      panel
    >
      <ul class="proof">
        <li><span>Dolby Vision</span><span>Profiles 5 and 8</span></li>
        <li><span>Dolby Atmos</span><span>Passed through untouched</span></li>
        <li><span>TrueHD and DTS</span><span>Bridged to lossless FLAC</span></li>
        <li><span>Your server</span><span>Sends the file, nothing more</span></li>
      </ul>
    </Showcase>

    <Showcase
      question={"Can I make the subtitles readable?"}
      answer={"Plozz draws its own, so they look the same on every server."}
      detail={"Seven typefaces, two of them made for people who find subtitles hard to read."}
      flip
    >
      <SubtitleLab />
    </Showcase>

    <Showcase
      question={"Does it skip intros?"}
      answer={"Yes, using the markers Jellyfin already has."}
      detail={"Reads Media Segments, or the Intro Skipper plugin."}
      panel
    >
      <ul class="proof">
        <li><span>Off</span><span>Never touch it</span></li>
        <li><span>On</span><span>Show a Skip button</span></li>
        <li><span>Auto (delay)</span><span>Skip after five seconds, cancellable</span></li>
        <li><span>Auto (instant)</span><span>Gone before you notice</span></li>
      </ul>
    </Showcase>

    <FactSection
      title="Compatibility"
      lead={"What plays without your server lifting a finger."}
      facts={compatibility}
    />

    <section class="closer" aria-labelledby="page-closer">
      <div class="container">
        <h2 id="page-closer">Free forever.<br />Open source.</h2>
        <p>No subscription and no paid tier. GPL-3.0 on GitHub.</p>
        <div class="closer-cta">
          <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
            Join the TestFlight beta
          </a>
          <a class="btn btn-light btn-lg" href="/features">The questions people ask</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
