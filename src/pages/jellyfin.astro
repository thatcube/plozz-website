---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import DirectPath from '../components/DirectPath.astro';
import Shot from "../components/Shot.astro";
import { FIGURE } from "../data/imageSizes";

const title = "Jellyfin client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Jellyfin client for Apple TV, iPhone and iPad. Plays MKV, Dolby Vision, TrueHD and PGS subtitles on the device, so Jellyfin never transcodes.";
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      title={"Jellyfin, without the transcode."}
      lead={"Your Apple TV opens the file itself. Jellyfin doesn’t have to re-encode anything on the way, so it hands over what’s on the disk and goes back to sitting there."}
    />

    <Showcase
      question={"Nothing happens in the middle"}
      detail={"Plozz tells Jellyfin what it can decode, and that list covers MKV, AV1, DTS-HD and TrueHD. So the server marks the file direct-play and streams it as it is. No re-encode, no pegged CPU, no second copy at lower quality."}
    >
      <DirectPath source="Jellyfin" logo="/providers/jellyfin.svg" />
    </Showcase>

    <Showcase
      question={"Why a 4K remux says it can’t be played"}
      detail={"It’s usually the subtitles. A remux that ships a PGS track as its default asks a player to draw a picture, and Apple’s can’t — so Jellyfin burns the subtitle into the video instead, which means re-encoding the whole film. What comes back is an HDR10 stream the Apple TV then refuses. Plozz draws PGS itself, so the burn-in never starts and the file plays untouched."}
      flip
    >
      <Shot
        name="plozz-tv-subtitles"
        alt="The subtitle style panel open during playback, with the typeface, size and position being changed while the scene keeps playing"
        sizes={FIGURE}
        class="shot"
      />
    </Showcase>

    <Showcase
      question={"Scrubbing shows the frame you’re heading for"}
      detail={"Jellyfin generates trickplay tiles for your library, and Plozz reads them at the highest resolution your server made. Hold the remote and the picture under your thumb is the one you’ll land on."}
    >
      <Shot
        name="plozz-tv-player"
        alt="The Plozz player with the transport bar open, showing a preview thumbnail above the scrub position"
        sizes={FIGURE}
        class="shot"
      />
    </Showcase>

    <Closer secondaryHref="/formats" secondaryLabel="Every format, in full" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
