---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Stage from '../components/Stage.astro';
import Showcase from '../components/Showcase.astro';
import LockPair from '../components/LockPair.astro';
import Shot from "../components/Shot.astro";
import { STAGE, FIGURE } from "../data/imageSizes";

const title = "Jellyfin client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Jellyfin client for Apple TV, iPhone and iPad. Profiles for everyone in the house, kids profiles, a parental PIN, and 4K HDR that plays straight off your server.";

---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      title={"Everyone gets their own Jellyfin."}
      lead={"Their libraries, their home screen, their place in the show they’re halfway through. Pick a face on the way in and the app is theirs until someone else picks another."}
    />

    <Stage
      title={"A profile each, kids included"}
      caption={"Profiles are the app’s, not the server’s, so they work the same whether you run Jellyfin, Plex, Emby or a folder on a NAS."}
    >
      <Shot
        name="plozz-tv-profiles"
        alt="The Plozz profile picker on Apple TV, showing Timmy, mom and dad and Gerard alongside buttons to add a profile or add a kids profile"
        sizes={STAGE}
        loading="eager"
        fetchpriority="high"
      />
    </Stage>

    <Showcase
      question={"A profile for the four-year-old"}
      detail={"A kids profile is a smaller app: the household settings aren’t on the page, so there’s nothing to wander into. Add a parental PIN and it turns from tidying into a rule — switching out, and reaching the editor that holds the kids flag, both cost the PIN. Without one it still works, and nothing is ever locked behind a key nobody has."}
      flip
    >
      <Shot
        name="plozz-tv-profile-edit"
        alt="Editing a profile on Apple TV, choosing an emoji avatar and a tile colour"
        sizes={FIGURE}
        class="shot"
      />
    </Showcase>

    <LockPair />

    <Closer secondaryHref="/formats" secondaryLabel="Every format, in full" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
