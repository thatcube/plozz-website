---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import FactSection from '../components/FactSection.astro';
import { TESTFLIGHT_URL } from '../data/site';

const title = "Jellyfin client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Jellyfin client for Apple TV, iPhone and iPad. Plays MKV without transcoding, with Dolby Vision, Atmos and deep subtitle control.";

const facts0 = [
  {
    "name": "Video",
    "chips": [
      "HEVC",
      "H.264",
      "VP9",
      "AV1"
    ]
  },
  {
    "name": "HDR",
    "chips": [
      "Dolby Vision P5",
      "Dolby Vision P8",
      "HDR10",
      "HLG"
    ]
  },
  {
    "name": "Audio",
    "value": "Atmos passthrough. TrueHD and DTS bridged to lossless FLAC."
  },
  {
    "name": "Skip intros and credits",
    "chips": [
      "Off",
      "On",
      "Auto (delay)",
      "Auto (instant)"
    ]
  },
  {
    "name": "Marker source",
    "value": "Jellyfin Media Segments, or the Intro Skipper plugin."
  },
  {
    "name": "Scrub thumbnails",
    "value": "Jellyfin trickplay tiles."
  }
];

const facts1 = [
  {
    "name": "Fonts",
    "chips": [
      "Atkinson Hyperlegible",
      "System",
      "SF Rounded",
      "Roboto",
      "Lexend",
      "Fredoka",
      "OpenDyslexic"
    ]
  },
  {
    "name": "Presets",
    "chips": [
      "Clean",
      "Boxed",
      "Outline",
      "Classic Yellow"
    ]
  },
  {
    "name": "Hearing impaired",
    "chips": [
      "Prefer non-SDH",
      "Prefer SDH",
      "Only SDH",
      "Only non-SDH"
    ]
  },
  {
    "name": "Two at once",
    "value": "A second language above or below, at its own size and colour."
  },
  {
    "name": "Bitmap subtitles",
    "value": "PGS, DVB and DVD decoded on the device."
  }
];

const facts2 = [
  {
    "name": "One library",
    "value": "Jellyfin merges with Plex, Emby and network shares, or keeps its own rows."
  },
  {
    "name": "Watch state",
    "value": "Converges across every server holding the title, or stays on the origin."
  },
  {
    "name": "Per series memory",
    "value": "Audio and subtitle choices stick for the whole series."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Jellyfin"}
      title={"A Jellyfin client that plays your files, not a transcode of them."}
      lead={"Plozz demuxes Matroska on the device, so your server sends the original file and stops burning CPU on re-encodes."}
    />

    <FactSection
      title={"Playback"}
      lead={"Built on AetherEngine, an open source FFmpeg engine that runs on the device."}
      facts={facts0}
      panel
    />

    <FactSection
      title={"Subtitles"}
      lead={"Plozz draws its own, which is why there is this much to change."}
      facts={facts1}
    />

    <FactSection
      title={"Your library"}
      facts={facts2}
      panel
    />

    <section class="closer" aria-labelledby="page-closer">
      <div class="container">
        <h2 id="page-closer">Free forever.<br />Open source.</h2>
        <p>No subscription and no paid tier. GPL-3.0 on GitHub.</p>
        <div class="closer-cta">
          <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
            Join the TestFlight beta
          </a>
          <a class="btn btn-light btn-lg" href={"/features"}>See every setting</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
