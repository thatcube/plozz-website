---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import SubtitleLab from '../components/SubtitleLab.astro';
import FactSection from '../components/FactSection.astro';

const title = "Emby client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Emby client for Apple TV, iPhone and iPad. Full playback on iPhone with no time limit and no Emby Premiere.";

const compatibility = [
  {
    "name": "Video",
    "chips": [
      "HEVC",
      "H.264",
      "VP9",
      "AV1"
    ]
  },
  {
    "name": "HDR",
    "chips": [
      "Dolby Vision P5",
      "Dolby Vision P8",
      "HDR10",
      "HLG"
    ]
  },
  {
    "name": "Subtitles",
    "chips": [
      "SRT",
      "ASS",
      "SSA",
      "VTT",
      "PGS",
      "DVB",
      "DVD"
    ]
  },
  {
    "name": "One library",
    "value": "Merges with Plex, Jellyfin and network shares, or keeps its own rows."
  },
  {
    "name": "Hide anything",
    "value": "Any library can leave Home and Search without disconnecting."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Emby"}
      title={"Emby, not an afterthought."}
    />

    <Showcase
      question={"Will it wreck my server?"}
    >
      <ul class="proof">
        <li><span>Dolby Vision</span><span>Profiles 5, 7, 8.1 and 8.4</span></li>
        <li><span>Dolby Atmos</span><span>Stream-copied from E-AC-3, not re-encoded</span></li>
        <li><span>TrueHD and DTS-HD MA</span><span>Play free, bridged to surround or lossless FLAC</span></li>
        <li><span>Your server</span><span>Hands over the file, nothing more</span></li>
      </ul>
    </Showcase>

    <Showcase
      question={"Can I make the subtitles readable?"}
      flip
    >
      <SubtitleLab />
    </Showcase>

    <Showcase
      question={"Is Emby treated like Jellyfin?"}
    >
      <ul class="proof">
        <li><span>Shared protocol</span><span>MediaBrowser, for both</span></li>
        <li><span>HDR reporting</span><span>Classified differently, handled per server</span></li>
        <li><span>Studio IDs</span><span>Formatted differently, handled per server</span></li>
        <li><span>Status</span><span>A provider in its own right</span></li>
      </ul>
    </Showcase>

    <FactSection
      title="Compatibility"
      facts={compatibility}
    />

    <Closer secondaryHref="/features" secondaryLabel="The questions people ask" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
