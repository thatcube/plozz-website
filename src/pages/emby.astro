---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import FactSection from '../components/FactSection.astro';
import { TESTFLIGHT_URL } from '../data/site';

const title = "Emby client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Emby client for Apple TV, iPhone and iPad. Emby is a first-class source alongside Plex, Jellyfin and network shares.";

const facts0 = [
  {
    "name": "Video",
    "chips": [
      "HEVC",
      "H.264",
      "VP9",
      "AV1"
    ]
  },
  {
    "name": "HDR",
    "chips": [
      "Dolby Vision P5",
      "Dolby Vision P8",
      "HDR10",
      "HLG"
    ]
  },
  {
    "name": "Audio",
    "value": "Atmos passthrough. TrueHD and DTS bridged to lossless FLAC."
  },
  {
    "name": "MKV",
    "value": "Demuxed on the device, so Emby is never asked to transcode."
  },
  {
    "name": "Skip intros and credits",
    "chips": [
      "Off",
      "On",
      "Auto (delay)",
      "Auto (instant)"
    ]
  }
];

const facts1 = [
  {
    "name": "Shared client",
    "value": "Both speak MediaBrowser, so they share one client in Plozz."
  },
  {
    "name": "Differences detected",
    "value": "HDR classification and studio ID formats differ. Plozz adapts per server."
  },
  {
    "name": "First class",
    "value": "Emby is a provider in its own right, not a compatibility shim."
  }
];

const facts2 = [
  {
    "name": "One library",
    "value": "Emby merges with Plex, Jellyfin and network shares, or keeps its own rows."
  },
  {
    "name": "Watch state",
    "value": "Converges across every server holding the title, or stays on the origin."
  },
  {
    "name": "Hide anything",
    "value": "Any library can leave Home and Search without disconnecting the server."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Emby"}
      title={"An Emby client, not a Jellyfin client that tolerates Emby."}
      lead={"Emby gets the same player, the same subtitle control and the same place in your merged library as everything else."}
    />

    <FactSection
      title={"Playback"}
      lead={"Built on AetherEngine, an open source FFmpeg engine that runs on the device."}
      facts={facts0}
      panel
    />

    <FactSection
      title={"How Emby is handled"}
      lead={"Emby and Jellyfin are close relatives, right up until they are not."}
      facts={facts1}
    />

    <FactSection
      title={"Your library"}
      facts={facts2}
      panel
    />

    <section class="closer" aria-labelledby="page-closer">
      <div class="container">
        <h2 id="page-closer">Free forever.<br />Open source.</h2>
        <p>No subscription and no paid tier. GPL-3.0 on GitHub.</p>
        <div class="closer-cta">
          <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
            Join the TestFlight beta
          </a>
          <a class="btn btn-light btn-lg" href={"/features"}>See every setting</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
