---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Closer from '../components/Closer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Stage from '../components/Stage.astro';
import Showcase from '../components/Showcase.astro';
import Shot from "../components/Shot.astro";
import { STAGE, FIGURE } from "../data/imageSizes";

const title = "Emby client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Emby client for Apple TV, iPhone and iPad. Emby is a provider in its own right, down to finding the Atmos its API doesn’t report.";
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      title={"Emby, not an afterthought."}
      lead={"Emby and Jellyfin share an ancestor, which is usually where support for the younger one stops. Emby’s own discovery, its own chapter markers, its own trickplay, and the sound it forgets to mention."}
    />

    <Stage
      title={"Atmos it never told us about"}
      caption={"Emby’s API doesn’t always report Dolby Atmos on an E-AC-3 track. Rather than take its word for it, Plozz decodes a single frame after the page has drawn, and adds the badge when it finds one."}
    >
      <Shot
        name="plozz-tv-lotr"
        alt="A film detail page in Plozz on Apple TV, showing 4K, Dolby Vision and Dolby Atmos badges beneath the running time"
        sizes={STAGE}
        loading="eager"
        fetchpriority="high"
      />
    </Stage>

    <Showcase
      question={"Found on your network, not typed in"}
      detail={"Emby announces itself over the network, so the server is usually already in the list by the time you get to it. Where the two servers differ underneath — how each classifies HDR, where each keeps its intro markers, how each serves scrub thumbnails — Plozz follows Emby rather than guessing from Jellyfin."}
      flip
    >
      <Shot
        name="plozz-tv-cast"
        alt="A cast page in Plozz on Apple TV, showing an actor with the titles they appear in"
        sizes={FIGURE}
        class="shot"
      />
    </Showcase>

    <Closer secondaryHref="/features" secondaryLabel="Everything it does" />
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
