---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Showcase from '../components/Showcase.astro';
import SubtitleLab from '../components/SubtitleLab.astro';
import FactSection from '../components/FactSection.astro';
import { TESTFLIGHT_URL } from '../data/site';

const title = "Emby client for Apple TV, iPhone and iPad — Plozz";
const description = "A free, open source Emby client for Apple TV, iPhone and iPad. Full playback on iPhone with no time limit and no Emby Premiere.";

const compatibility = [
  {
    "name": "Video",
    "chips": [
      "HEVC",
      "H.264",
      "VP9",
      "AV1"
    ]
  },
  {
    "name": "HDR",
    "chips": [
      "Dolby Vision P5",
      "Dolby Vision P8",
      "HDR10",
      "HLG"
    ]
  },
  {
    "name": "Subtitles",
    "chips": [
      "SRT",
      "ASS",
      "SSA",
      "VTT",
      "PGS",
      "DVB",
      "DVD"
    ]
  },
  {
    "name": "One library",
    "value": "Merges with Plex, Jellyfin and network shares, or keeps its own rows."
  },
  {
    "name": "Hide anything",
    "value": "Any library can leave Home and Search without disconnecting."
  }
];
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow={"Emby"}
      title={"Emby, not an afterthought."}
      lead={"Same player, same subtitle control, same place in your library as everything else you connect."}
    />

    <Showcase
      question={"Will it wreck my server?"}
      answer={"No. Your Apple TV opens the file and plays it."}
      detail={"Nothing upstream re-encodes a thing, so Emby sits idle while you watch."}
      panel
    >
      <ul class="proof">
        <li><span>Dolby Vision</span><span>Profiles 5, 7, 8.1 and 8.4</span></li>
        <li><span>Dolby Atmos</span><span>Stream-copied from E-AC-3, not re-encoded</span></li>
        <li><span>TrueHD and DTS-HD MA</span><span>Play free, bridged to surround or lossless FLAC</span></li>
        <li><span>Your server</span><span>Hands over the file, nothing more</span></li>
      </ul>
    </Showcase>

    <Showcase
      question={"Can I make the subtitles readable?"}
      answer={"Plozz draws its own, so they look the same everywhere."}
      detail={"Seven typefaces. Two were built for people who struggle to read subtitles at all."}
      flip
    >
      <SubtitleLab />
    </Showcase>

    <Showcase
      question={"Is Emby treated like Jellyfin?"}
      answer={"They share a client, but not blindly."}
      detail={"Both speak MediaBrowser, so one client serves both. Where they differ, Plozz works it out per server."}
      panel
    >
      <ul class="proof">
        <li><span>Shared protocol</span><span>MediaBrowser, for both</span></li>
        <li><span>HDR reporting</span><span>Classified differently, handled per server</span></li>
        <li><span>Studio IDs</span><span>Formatted differently, handled per server</span></li>
        <li><span>Status</span><span>A provider in its own right</span></li>
      </ul>
    </Showcase>

    <FactSection
      title="Compatibility"
      lead={"What plays without your server lifting a finger."}
      facts={compatibility}
    />

    <section class="closer" aria-labelledby="page-closer">
      <div class="container">
        <h2 id="page-closer">Free forever.<br />Open source.</h2>
        <p>No subscription, no paid tier. The whole thing is GPL-3.0 on GitHub.</p>
        <div class="closer-cta">
          <a class="btn btn-primary btn-lg btn-cta" href={TESTFLIGHT_URL} target="_blank" rel="noopener">
            Join the TestFlight beta
          </a>
          <a class="btn btn-light btn-lg" href="/features">The questions people ask</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <SiteScripts />
</Layout>
