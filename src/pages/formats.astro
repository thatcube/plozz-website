---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import PageHero from '../components/PageHero.astro';
import Closer from '../components/Closer.astro';
import { FORMAT_TABLE, FORMAT_CAVEATS } from '../data/site';

const title = 'Supported formats — Plozz, a free media player for Apple TV';
const description =
  'Every video, audio and subtitle format Plozz plays: Dolby Vision including Profile 7, HDR10+, Dolby Atmos, TrueHD, DTS-HD MA, MKV, AV1, PGS subtitles and Blu-ray images. All free, no Pro tier.';

/** Answers the "does it play X" queries people actually type. */
const faqs = [
  {
    q: 'Does Plozz play MKV on Apple TV?',
    a: 'Yes. Plozz opens Matroska files on the device itself, so your server sends the original file instead of transcoding it.',
  },
  {
    q: 'Does Plozz support Dolby Vision?',
    a: 'Yes, profiles 5, 7, 8.1 and 8.4. Profile 7 is the one used by UHD Blu-ray remuxes, and Plozz converts it to Profile 8.1 during playback because Apple hardware cannot decode it directly.',
  },
  {
    q: 'Does Plozz support Dolby Atmos?',
    a: 'Yes. E-AC-3 with JOC is copied straight through without re-encoding, so your receiver gets the Atmos bitstream intact. TrueHD Atmos plays too, but its object metadata is not preserved.',
  },
  {
    q: 'Does it cost anything?',
    a: 'No. Plozz is free and open source under GPL-3.0, with no Pro tier, no subscription and nothing to unlock. Every format on this page works for everyone.',
  },
  {
    q: 'Does Plozz play HDR10+?',
    a: 'Yes. The per-frame metadata is passed through to your TV rather than flattened to static HDR10.',
  },
  {
    q: 'Can it play Blu-ray and DVD images?',
    a: 'Yes, decrypted ISO images, with title and chapter selection.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <PageHero
      eyebrow="Formats"
      title="If it's in your library, it plays."
    />

    {FORMAT_TABLE.map((section) => (
      <section class="fmt" aria-labelledby={section.group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
        <div class="container">
          <div class="fmt-body">
            <h2 id={section.group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{section.group}</h2>
            <ul class="fmt-rows">
              {section.rows.map((row) => (
                <li>
                  <span class="fmt-name">{row.name}</span>
                  {row.note && <span class="fmt-note">{row.note}</span>}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))}

    <section class="fmt" aria-labelledby="caveats">
      <div class="container">
        <div class="fmt-body is-panel">
          <h2 id="caveats">Worth knowing</h2>
          <ul class="fmt-rows">
            {FORMAT_CAVEATS.map((caveat) => (
              <li>
                <span class="fmt-name">{caveat.name}</span>
                <span class="fmt-note">{caveat.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-heading">
      <div class="container">
        <h2 id="faq-heading">Common questions</h2>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <Closer secondaryHref="/features" secondaryLabel="The questions people ask" />
  </main>

  <SiteFooter />
  <SiteScripts />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Layout>
